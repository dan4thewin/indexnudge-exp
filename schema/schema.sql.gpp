-- indexnudge shared schema — the contract between indexers, shims, and tree patch.
-- Both rust and go indexers must produce these tables identically.

PRAGMA journal_mode=WAL;
PRAGMA synchronous=OFF;

CREATE TABLE lines (
    file     TEXT,
    line_num INTEGER,
    content  TEXT,
    symbol   TEXT,
    PRIMARY KEY (file, line_num)
);
CREATE VIRTUAL TABLE lines_fts USING fts5(file, line_num, content, symbol);

CREATE TABLE symbols (
    id             INTEGER PRIMARY KEY,
    name           TEXT,
    qualified_name TEXT,
    kind           TEXT,
    file           TEXT,
    start_line     INTEGER,
    end_line       INTEGER,
    parent         TEXT,
    signature      TEXT,
    cyclomatic     INTEGER       -- McCabe complexity for functions/methods; NULL otherwise
);

CREATE TABLE calls (
    caller_file   TEXT,
    caller_symbol TEXT,
    callee        TEXT,
    callee_qname  TEXT,
    kind          TEXT,
    line_num      INTEGER
);

CREATE TABLE defs (
    symbol TEXT,
    file   TEXT,
    line_num INTEGER,
    var    TEXT,
    kind   TEXT
);

CREATE TABLE imports (
    file   TEXT,
    module TEXT,
    line_num INTEGER
);

CREATE INDEX idx_symbols_name ON symbols(name);
CREATE INDEX idx_symbols_qualified ON symbols(qualified_name);
CREATE INDEX idx_symbols_file ON symbols(file);
CREATE INDEX idx_symbols_cyclomatic ON symbols(cyclomatic);
CREATE INDEX idx_calls_callee ON calls(callee);
CREATE INDEX idx_calls_caller ON calls(caller_symbol);
CREATE INDEX idx_defs_var ON defs(var);
CREATE INDEX idx_imports_module ON imports(module);

CREATE TABLE files (
    file           TEXT PRIMARY KEY,
    lines          INTEGER,
    language       TEXT,
    indexed_mtime  REAL
);

CREATE TABLE directories (
    path        TEXT PRIMARY KEY,
    file_count  INTEGER,
    total_lines INTEGER
);

-- Call-target disambiguation view. One row per (call site, candidate symbol).
-- Calls whose `callee_qname` was resolved by the indexer (Go's go/types pass)
-- return at most one candidate — the exact qualified-name match. Calls left
-- with `callee_qname IS NULL` (Rust today) return every local symbol sharing
-- the short name. Agents narrow further with proximity / parent-type / arity
-- filters at query time. See AGENTS.md snippet for examples.
CREATE VIEW callee_candidates AS
SELECT
    c.caller_file,
    c.caller_symbol,
    c.callee,
    c.callee_qname,
    c.line_num       AS call_line,
    c.kind           AS call_kind,
    s.qualified_name AS candidate_qname,
    s.file           AS def_file,
    s.start_line     AS def_line,
    s.parent         AS def_parent,
    s.signature
FROM calls c
LEFT JOIN symbols s
    ON s.name = c.callee
   AND s.kind IN ('function','method')
   AND (c.callee_qname IS NULL OR s.qualified_name = c.callee_qname);

-- String-literal extraction view. Peels every double-quoted string off each
-- line of source, one row per occurrence, with a coarse `context` bucket
-- derived from surrounding line text.
--
-- Limitations (acceptable for the dispatch-discovery use case):
--   - One line at a time: multi-line strings and raw strings with embedded
--     newlines are extracted only up to the first \n.
--   - Escaped quotes (\") split strings early — rare in dispatch code.
--   - Context is line-level heuristic, not AST-parent. Good enough to filter
--     `compare`/`match_pat` from `fmt`/`arg`, but not perfect.
--
-- Filters out lines beginning with // or /// (doc-comment false positives).
-- See AGENTS.md snippet for query patterns.
CREATE VIEW string_literals AS
WITH RECURSIVE peeled(file, line_num, symbol, content, value, rest, pos) AS (
    SELECT file, line_num, symbol, content,
           substr(content,
                  instr(content, '"') + 1,
                  instr(substr(content, instr(content, '"') + 1), '"') - 1),
           substr(substr(content, instr(content, '"') + 1),
                  instr(substr(content, instr(content, '"') + 1), '"') + 1),
           1
    FROM lines
    WHERE content LIKE '%"%"%'
      AND trim(content) NOT LIKE '//%'
    UNION ALL
    SELECT file, line_num, symbol, content,
           substr(rest, instr(rest, '"') + 1,
                  instr(substr(rest, instr(rest, '"') + 1), '"') - 1),
           substr(substr(rest, instr(rest, '"') + 1),
                  instr(substr(rest, instr(rest, '"') + 1), '"') + 1),
           pos + 1
    FROM peeled
    WHERE rest LIKE '%"%"%' AND pos < 8
)
SELECT file, line_num, symbol, value, pos,
       CASE
           WHEN content LIKE '%==%"' || value || '"%'
             OR content LIKE '%!=%"' || value || '"%' THEN 'compare'
#ifdef LANG_GO
           WHEN content LIKE '%case %"' || value || '"%' THEN 'match_pat'
           WHEN content LIKE '%fmt.Print%'
             OR content LIKE '%fmt.Sprint%'
             OR content LIKE '%fmt.Errorf%'
             OR content LIKE '%fmt.Fprintf%'
             OR content LIKE '%log.Print%'
             OR content LIKE '%log.Fatal%'            THEN 'fmt'
#else
           WHEN content LIKE '%"' || value || '"%=>%'
             OR content LIKE '%"' || value || '" |%'
             OR content LIKE '%| "' || value || '"%'  THEN 'match_pat'
           WHEN content LIKE '%format!%'
             OR content LIKE '%println!%'
             OR content LIKE '%write!%'
             OR content LIKE '%writeln!%'
             OR content LIKE '%eprintln!%'
             OR content LIKE '%panic!%'               THEN 'fmt'
#endif
           ELSE 'arg'
       END AS context
FROM peeled
WHERE value != '';

-- Block-duplication view: contiguous 4-line runs that appear 2+ times
-- across the codebase. Identifies candidates for extract-helper / extract-
-- macro / parameter-object refactors.
--
-- Normalization: each line is lowercased and stripped of leading/trailing
-- whitespace before hashing. Blank lines are dropped (the shingle skips
-- them so the 4 lines are contiguous in non-blank space, not necessarily
-- in line-number space).
--
-- Limitations:
--   - k=4 fixed. For longer/shorter k, write a similar CTE inline.
--   - Identifier renaming is NOT normalized: `let ptr = ...` and `let dest
--     = ...` hash differently. In practice the dominant duplicates are
--     literally identical (function signatures, test scaffolding, setup
--     boilerplate), so this matters less than expected.
--   - Overlapping shingles within one larger duplicated block all appear
--     separately — agents merge with their own SQL or by inspection.
--
-- Performance: ~200ms cold scan on a 30K-line codebase. Acceptable.
CREATE VIEW block_dupes AS
WITH ln AS (
    SELECT file, line_num, trim(lower(content)) AS norm,
           ROW_NUMBER() OVER (PARTITION BY file ORDER BY line_num) AS seq
    FROM lines
    WHERE trim(content) != ''
),
sh AS (
    SELECT a.file, a.line_num AS start_line, d.line_num AS end_line,
           a.norm || char(10) || b.norm || char(10) || c.norm || char(10) || d.norm AS shingle
    FROM ln a
    JOIN ln b ON b.file = a.file AND b.seq = a.seq + 1
    JOIN ln c ON c.file = a.file AND c.seq = a.seq + 2
    JOIN ln d ON d.file = a.file AND d.seq = a.seq + 3
)
SELECT shingle,
       COUNT(*) AS occurrences,
       GROUP_CONCAT(file || ':' || start_line, ' | ') AS sites
FROM sh
GROUP BY shingle
HAVING COUNT(*) >= 2;


#ifdef LANG_GO
-- Go-specific: channel operations (make, send, recv, close, range, select)
CREATE TABLE channels (
    id        INTEGER PRIMARY KEY,
    file      TEXT,
    symbol    TEXT,
    line_num  INTEGER,
    operation TEXT,
    var       TEXT
);
CREATE INDEX idx_channels_var ON channels(var);
CREATE INDEX idx_channels_file ON channels(file);
#endif
