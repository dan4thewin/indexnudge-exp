-- indexnudge shared schema — the contract between indexers, shims, and tree patch.
-- Both rust and go indexers must produce these tables identically.

PRAGMA journal_mode=WAL;
PRAGMA synchronous=OFF;

CREATE TABLE lines (
    file     TEXT,
    line_num INTEGER,
    content  TEXT,
    symbol   TEXT,
    PRIMARY KEY (file, line_num)
);
CREATE VIRTUAL TABLE lines_fts USING fts5(file, line_num, content, symbol);

CREATE TABLE symbols (
    id             INTEGER PRIMARY KEY,
    name           TEXT,
    qualified_name TEXT,
    kind           TEXT,
    file           TEXT,
    start_line     INTEGER,
    end_line       INTEGER,
    parent         TEXT,
    signature      TEXT,
    cyclomatic     INTEGER       -- McCabe complexity for functions/methods; NULL otherwise
);

CREATE TABLE calls (
    caller_file   TEXT,
    caller_symbol TEXT,
    callee        TEXT,
    callee_qname  TEXT,
    kind          TEXT,
    line_num      INTEGER
);

CREATE TABLE defs (
    symbol TEXT,
    file   TEXT,
    line_num INTEGER,
    var    TEXT,
    kind   TEXT
);

CREATE TABLE imports (
    file   TEXT,
    module TEXT,
    line_num INTEGER
);

CREATE INDEX idx_symbols_name ON symbols(name);
CREATE INDEX idx_symbols_qualified ON symbols(qualified_name);
CREATE INDEX idx_symbols_file ON symbols(file);
CREATE INDEX idx_symbols_cyclomatic ON symbols(cyclomatic);
CREATE INDEX idx_calls_callee ON calls(callee);
CREATE INDEX idx_calls_caller ON calls(caller_symbol);
CREATE INDEX idx_defs_var ON defs(var);
CREATE INDEX idx_imports_module ON imports(module);

CREATE TABLE files (
    file           TEXT PRIMARY KEY,
    lines          INTEGER,
    language       TEXT,
    indexed_mtime  REAL
);

CREATE TABLE directories (
    path        TEXT PRIMARY KEY,
    file_count  INTEGER,
    total_lines INTEGER
);

-- Call-target disambiguation view. One row per (call site, candidate symbol).
-- Calls whose `callee_qname` was resolved by the indexer (Go's go/types pass)
-- return at most one candidate — the exact qualified-name match. Calls left
-- with `callee_qname IS NULL` (Rust today) return every local symbol sharing
-- the short name. Agents narrow further with proximity / parent-type / arity
-- filters at query time. See AGENTS.md snippet for examples.
CREATE VIEW callee_candidates AS
SELECT
    c.caller_file,
    c.caller_symbol,
    c.callee,
    c.callee_qname,
    c.line_num       AS call_line,
    c.kind           AS call_kind,
    s.qualified_name AS candidate_qname,
    s.file           AS def_file,
    s.start_line     AS def_line,
    s.parent         AS def_parent,
    s.signature
FROM calls c
LEFT JOIN symbols s
    ON s.name = c.callee
   AND s.kind IN ('function','method')
   AND (c.callee_qname IS NULL OR s.qualified_name = c.callee_qname);

#ifdef LANG_GO
-- Go-specific: channel operations (make, send, recv, close, range, select)
CREATE TABLE channels (
    id        INTEGER PRIMARY KEY,
    file      TEXT,
    symbol    TEXT,
    line_num  INTEGER,
    operation TEXT,
    var       TEXT
);
CREATE INDEX idx_channels_var ON channels(var);
CREATE INDEX idx_channels_file ON channels(file);
#endif
