#!/usr/bin/env bash
# indexnudge shim for cat — serve indexed source from DB with symbol dividers.
set -euo pipefail
SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SHIM_DIR/_indexnudge_common.bash"

REAL_CAT=cat

# Pipe/stdin: pass through
if [[ ! -t 0 ]] && [[ $# -eq 0 ]]; then
    exec "$REAL_CAT" "$@"
fi

# No args or dash: pass through
if [[ $# -eq 0 ]] || [[ "$1" == "-" ]]; then
    exec "$REAL_CAT" "$@"
fi

# Collect files and flags
files=() flags=()
for arg; do
    case "$arg" in
        -*) flags+=("$arg") ;;
        *)  files+=("$arg") ;;
    esac
done

# Single file, try indexnudge
if [[ ${#files[@]} -eq 1 ]] && [[ -f "${files[0]}" ]]; then
    abs=$(resolve_path "${files[0]}")
    if find_indexnudge_db "$abs"; then
        freshen_db
        rel=$(rel_path "$abs")
        in_index=$(sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" "SELECT count(*) FROM files WHERE file='$rel';")
        if [[ "$in_index" -gt 0 ]]; then
            query="SELECT
    CASE WHEN NULLIF(l.symbol,'') IS NOT NULL
         AND (COALESCE(NULLIF(l.symbol,''),'') != COALESCE(NULLIF(LAG(l.symbol) OVER (ORDER BY l.line_num),''),'')
              OR LAG(l.line_num) OVER (ORDER BY l.line_num) IS NULL)
         THEN char(10) || '  ── ' || COALESCE(NULLIF(l.symbol,''), '(top-level)') ||
              COALESCE(' (L' || s.start_line || '-L' || s.end_line || ')', '') ||
              ' ──' || char(10)
         ELSE '' END ||
    printf('%4d', l.line_num) || ' │ ' || l.content as output
FROM lines l
LEFT JOIN symbols s ON s.file = l.file AND s.name = l.symbol AND l.symbol != ''
WHERE l.file = '$rel'
ORDER BY l.line_num;"

            result=$(timeout 5 sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" "$query" 2>/dev/null)
            if [[ -n "$result" ]]; then
                emit_preamble
                echo "── $rel ──"
                echo "$result"
                get_hint "$rel"
                exit 0
            fi
        fi
    fi
fi

exec "$REAL_CAT" "${flags[@]}" "${files[@]}"
