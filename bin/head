#!/usr/bin/env bash
# indexnudge shim for head — intercept head -n N file, serve from DB with symbol dividers.
set -euo pipefail
SHIM_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SHIM_DIR/_indexnudge_common.bash"

REAL_HEAD=head

# Stdin pipe with no file arg: pass through
if [[ ! -t 0 ]] && [[ $# -eq 0 ]]; then
    exec "$REAL_HEAD" "$@"
fi

# Parse: head [-n N] [file...]  or  head -N [file...]
n=10 file=""
args=("$@")
i=0
while (( i < ${#args[@]} )); do
    arg="${args[$i]}"
    case "$arg" in
        -n)
            i=$(( i + 1 ))
            n="${args[$i]}"
            ;;
        -[0-9]*)
            n="${arg#-}"
            ;;
        -*)
            exec "$REAL_HEAD" "$@"
            ;;
        *)
            file="$arg"
            ;;
    esac
    i=$(( i + 1 ))
done

if [[ -n "$file" ]] && [[ -f "$file" ]]; then
    abs=$(resolve_path "$file")
    if find_indexnudge_db "$abs"; then
        freshen_db
        rel=$(rel_path "$abs")
        in_index=$(sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" "SELECT count(*) FROM files WHERE file='$rel';")
        if [[ "$in_index" -gt 0 ]]; then
            query="SELECT
    CASE WHEN NULLIF(l.symbol,'') IS NOT NULL
         AND (COALESCE(NULLIF(l.symbol,''),'') != COALESCE(NULLIF(LAG(l.symbol) OVER (ORDER BY l.line_num),''),'')
              OR LAG(l.line_num) OVER (ORDER BY l.line_num) IS NULL)
         THEN char(10) || '  ── ' || COALESCE(NULLIF(l.symbol,''), '(top-level)') ||
              COALESCE(' (L' || s.start_line || '-L' || s.end_line || ')', '') ||
              ' ──' || char(10)
         ELSE '' END ||
    printf('%4d', l.line_num) || ' │ ' || l.content as output
FROM lines l
LEFT JOIN symbols s ON s.file = l.file AND s.name = l.symbol AND l.symbol != ''
WHERE l.file = '$rel' AND l.line_num <= $n
ORDER BY l.line_num;"

            result=$(timeout 5 sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" "$query" 2>/dev/null)
            if [[ -n "$result" ]]; then
                total=$(sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" "SELECT lines FROM files WHERE file='$rel';")
                emit_preamble
                echo "── $rel (first $n of $total lines) ──"
                echo "$result"
                get_hint "$rel"
                exit 0
            fi
        fi
    fi
fi

exec "$REAL_HEAD" "$@"
