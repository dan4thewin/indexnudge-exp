#!/usr/bin/env bash
# indexnudge shim for sed — intercept line-range reads, serve from DB with symbol dividers.
set -euo pipefail
SHIM_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SHIM_DIR/_indexnudge_common.bash"

REAL_SED=sed

# Detect: sed -n 'N,Mp' file
if [[ "$*" =~ -n ]]; then
    range="" file=""
    skip_next=false
    saw_n=false
    for arg; do
        if $skip_next; then skip_next=false; continue; fi
        case "$arg" in
            -n) saw_n=true ;;
            -[efi]) skip_next=true ;;
            -*)  ;;
            *)
                if [[ -z "$range" ]] && [[ "$arg" =~ ^([0-9]+),([0-9]+)p$ ]]; then
                    range="$arg"
                elif [[ -f "$arg" ]]; then
                    file="$arg"
                fi
                ;;
        esac
    done

    if $saw_n && [[ -n "$range" ]] && [[ -n "$file" ]]; then
        start="${range%%,*}"
        end="${range##*,}"; end="${end%p}"

        abs=$(resolve_path "$file")
        if find_indexnudge_db "$abs"; then
            freshen_db
            rel=$(rel_path "$abs")
            in_index=$(sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" "SELECT count(*) FROM files WHERE file='$rel';")
            if [[ "$in_index" -gt 0 ]]; then
                query="SELECT
    CASE WHEN NULLIF(l.symbol,'') IS NOT NULL
         AND (COALESCE(NULLIF(l.symbol,''),'') != COALESCE(NULLIF(LAG(l.symbol) OVER (ORDER BY l.line_num),''),'')
              OR LAG(l.line_num) OVER (ORDER BY l.line_num) IS NULL)
         THEN char(10) || '  ── ' || COALESCE(NULLIF(l.symbol,''), '(top-level)') ||
              COALESCE(' (L' || s.start_line || '-L' || s.end_line || ')', '') ||
              ' ──' || char(10)
         ELSE '' END ||
    printf('%4d', l.line_num) || ' │ ' || l.content as output
FROM lines l
LEFT JOIN symbols s ON s.file = l.file AND s.name = l.symbol AND l.symbol != ''
WHERE l.file = '$rel' AND l.line_num BETWEEN $start AND $end
ORDER BY l.line_num;"

                result=$(timeout 5 sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" "$query" 2>/dev/null)
                if [[ -n "$result" ]]; then
                    echo "── $rel (L$start-L$end) ──"
                    echo "$result"
                    get_hint "$rel"
                    exit 0
                fi
            fi
        fi
    fi
fi

exec "$REAL_SED" "$@"
