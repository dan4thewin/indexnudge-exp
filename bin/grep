#!/usr/bin/env bash
# indexnudge shim for grep — search via FTS5/LIKE, group output by symbol via SQL.
set -euo pipefail
SHIM_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SHIM_DIR/_indexnudge_common.bash"

REAL_GREP=grep

# Quick bail: stdin pipe with no file args (filter mode)
if [[ ! -t 0 ]] && [[ $# -le 1 ]]; then
    exec "$REAL_GREP" "$@"
fi

# Parse args
pattern="" files=() flags=() recursive=false
skip_next=false
for arg; do
    if $skip_next; then skip_next=false; flags+=("$arg"); continue; fi
    case "$arg" in
        -e|-f|--regexp|--file) skip_next=true; flags+=("$arg") ;;
        -r|-R|--recursive) recursive=true; flags+=("$arg") ;;
        -*)  flags+=("$arg") ;;
        *)
            if [[ -z "$pattern" ]]; then
                pattern="$arg"
            else
                files+=("$arg")
            fi
            ;;
    esac
done

if [[ -z "$pattern" ]]; then
    exec "$REAL_GREP" "$@"
fi

target=""
if $recursive; then
    target="${files[0]:-.}"
elif [[ ${#files[@]} -gt 0 ]]; then
    target="${files[0]}"
fi

if [[ -n "$target" ]]; then
    abs=$(resolve_path "$target")
    if find_indexnudge_db "$abs"; then
        freshen_db
        safe_pattern="${pattern//\'/\'\'}"

        if [[ "$pattern" =~ ^[a-zA-Z0-9_]+$ ]]; then
            match_clause="l.content MATCH '\"$safe_pattern\"'"
            source_table="lines_fts"
        else
            match_clause="l.content LIKE '%$safe_pattern%'"
            source_table="lines"
        fi

        query="SELECT
    CASE WHEN l.file != LAG(l.file) OVER (ORDER BY l.file, COALESCE(s.start_line,0), l.line_num)
              OR LAG(l.file) OVER (ORDER BY l.file, COALESCE(s.start_line,0), l.line_num) IS NULL
         THEN char(10) || '── ' || l.file || ' ──' || char(10) ELSE '' END ||
    CASE WHEN COALESCE(l.symbol,'') != COALESCE(LAG(l.symbol) OVER (ORDER BY l.file, COALESCE(s.start_line,0), l.line_num),'')
              OR l.file != LAG(l.file) OVER (ORDER BY l.file, COALESCE(s.start_line,0), l.line_num)
              OR LAG(l.file) OVER (ORDER BY l.file, COALESCE(s.start_line,0), l.line_num) IS NULL
         THEN char(10) || '  ' || COALESCE(l.symbol, '(top-level)') ||
              COALESCE(' (L' || s.start_line || '-L' || s.end_line || ')', '') || char(10)
         ELSE '' END ||
    '    ' || l.line_num || ' │ ' || l.content as output
FROM $source_table l
LEFT JOIN symbols s ON s.file = l.file AND s.name = l.symbol
WHERE $match_clause
ORDER BY l.file, COALESCE(s.start_line,0), l.line_num;"

        result=$(timeout 5 sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" "$query" 2>/dev/null)

        # No results — fall through silently
        if [[ -z "$result" ]]; then
            exec "$REAL_GREP" "$@"
        fi

        # Count stats
        if [[ "$pattern" =~ ^[a-zA-Z0-9_]+$ ]]; then
            stats=$(timeout 3 sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" \
                "SELECT COUNT(*), COUNT(DISTINCT file) FROM lines_fts WHERE content MATCH '\"$safe_pattern\"';" 2>/dev/null)
        else
            stats=$(timeout 3 sqlite3 -cmd '.timeout 5000' "$CODEINDEX_DB" \
                "SELECT COUNT(*), COUNT(DISTINCT file) FROM lines WHERE content LIKE '%$safe_pattern%';" 2>/dev/null)
        fi
        count=$(echo "$stats" | cut -d'|' -f1)
        nfiles=$(echo "$stats" | cut -d'|' -f2)

        echo "── sqlite3 $CODEINDEX_DB ──"
        echo ""
        echo "$result"
        echo ""
        echo "── $count matches across $nfiles file(s) ──"
        exit 0
    fi
fi

exec "$REAL_GREP" "$@"
