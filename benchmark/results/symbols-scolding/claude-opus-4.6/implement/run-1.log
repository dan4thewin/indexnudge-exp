#[test]
fn test_find_count_flag() {
    let dir = setup_workspace();

    write(
        dir.path().join("doc1.md"),
        indoc! {"
            # Document One

            Content one.
        "},
    )
    .unwrap();

    write(
        dir.path().join("doc2.md"),
        indoc! {"
            # Document Two

            Content two.
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);
    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout.trim(), "2");
}

#[test]
fn test_find_count_with_query() {
    let dir = setup_workspace();

    write(
        dir.path().join("doc1.md"),
        indoc! {"
            # Rust Guide

            Content about rust.
        "},
    )
    .unwrap();

    write(
        dir.path().join("doc2.md"),
        indoc! {"
            # Python Guide

            Content about python.
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count", "rust"]);
    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout.trim(), "1");
}

#[test]
fn test_find_count_with_roots() {
