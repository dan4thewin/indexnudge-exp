    path crates/liwe/src/markdown.rs
    before: /// If `bare_frontmatter` is enabled and content starts with `title: ` (but
/// not `---`), wrap the leading header block in `---` fences so the
/// downstream pulldown-cmark MetadataBlock machinery picks it up.
    after: /// Returns true if `content` starts with what looks like a bare YAML key line
/// (e.g. `title: Foo`, `depends:`, `created: 2024-01-01`).
fn looks_like_yaml_key(content: &str) -> bool {
    let first_line = content.lines().next().unwrap_or("");
    if let Some(colon_pos) = first_line.find(':') {
        // Key part must be non-empty and contain no spaces (simple YAML keys)
        let key = &first_line[..colon_pos];
        if key.is_empty() {
            return false;
        }
        // After the colon must be either end-of-line or a space
        let after_colon = &first_line[colon_pos + 1..];
        after_colon.is_empty() || after_colon.starts_with(' ')
    } else {
        false
    }
}

