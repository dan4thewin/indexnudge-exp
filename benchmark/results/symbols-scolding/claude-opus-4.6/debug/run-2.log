use pulldown_cmark::{Options, Parser, Event, Tag, TagEnd};

fn main() {
    // Fenced frontmatter (works)
    let fenced = "---\ntitle: My Doc\ndepends:\n  - foo\n---\n\n# Body\n";
    let opts = Options::ENABLE_YAML_STYLE_METADATA_BLOCKS;
    let parser = Parser::new_ext(fenced, opts);
    for event in parser {
        if let Event::Text(t) = &event {
            println!("fenced text: {:?}", t.as_ref());
        }
    }

    // Bare wrapped
    let bare = "title: My Doc\ndepends:\n  - foo\n\n# Body\n";
