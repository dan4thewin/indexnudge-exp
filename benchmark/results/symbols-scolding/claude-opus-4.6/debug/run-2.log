use liwe::markdown::wrap_bare_frontmatter;

fn main() {
    // Case: sequence items with "  - foo" — the \n\n could split mid-frontmatter
    // if there's a blank line between sequence items, or the sequence is the last field
    
    // Real TiddlyWiki-style bare frontmatter:
    let content = "title: My Doc\ndepends:\n- foo\n- bar\n\n# Body\n";
    let wrapped = wrap_bare_frontmatter(content);
    println!("Case 1 (no indent):\n{}\n---", wrapped);
    
    // With indented items (standard YAML)
    let content2 = "title: My Doc\ndepends:\n  - foo\n  - bar\n\n# Body\n";
    let wrapped2 = wrap_bare_frontmatter(content2);
    println!("Case 2 (indented):\n{}\n---", wrapped2);
    
    // Key insight: what if \n\n appears INSIDE the YAML sequence?
    // e.g. between two fields separated by blank line
    let content3 = "title: My Doc\n\ndepends:\n  - foo\n";
    let wrapped3 = wrap_bare_frontmatter(content3);
    println!("Case 3 (blank after title):\n{}\n---", wrapped3);
}
