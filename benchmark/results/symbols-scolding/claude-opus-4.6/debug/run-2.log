use liwe::graph::Graph;
use liwe::model::config::MarkdownOptions;
use liwe::state::from_indoc;
use liwe::find::{DocumentFinder, FindOptions};
use indoc::indoc;

fn main() {
    let opts = MarkdownOptions { bare_frontmatter: true, ..Default::default() };
    
    // Test with bare frontmatter + sequence
    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: My Doc
            depends:
              - foo
              - bar

            # Body
        "}),
        opts,
        None,
    );

    // Check metadata
    for key in graph.documents() {
        let meta = graph.get_metadata(&key);
        println!("key={}, metadata={:?}", key, meta);
    }

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    println!("find results: {}", output.results.len());
}
