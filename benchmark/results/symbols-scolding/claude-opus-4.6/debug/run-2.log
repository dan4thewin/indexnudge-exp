use liwe::graph::Graph;
use liwe::model::config::MarkdownOptions;
use liwe::state::from_indoc;
use liwe::find::{DocumentFinder, FindOptions};
use indoc::indoc;

fn main() {
    // Test: bare frontmatter where sequence uses "- foo" without indent
    // This is what TiddlyWiki / some users would write
    let opts = MarkdownOptions { bare_frontmatter: true, ..Default::default() };
    
    // No indent on list items
    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: My Doc
            depends:
            - foo
            - bar

            # Body
        "}),
        opts.clone(),
        None,
    );

    for key in graph.keys() {
        let meta = graph.get_metadata(&key);
        println!("no-indent: key={}, metadata={:?}", key, meta);
    }

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    println!("no-indent find results: {}", output.results.len());
    
    // What does wrap produce for "- foo" lines?
    let content = "title: My Doc\ndepends:\n- foo\n- bar\n\n# Body\n";
    let wrapped = liwe::markdown::wrap_bare_frontmatter(content);
    println!("\nwrapped content:\n{}", wrapped);
    
    // Parse the YAML
    let yaml: serde_yaml::Value = serde_yaml::from_str("title: My Doc\ndepends:\n- foo\n- bar\n").unwrap();
    println!("yaml parsed: {:?}", yaml.get("depends"));
}
