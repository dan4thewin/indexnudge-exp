fn main() {
    let content = "title: My Doc\ndepends:\n  - foo\n\n# Body\n";
    
    // Simulate wrap_bare_frontmatter
    let pos = content.find("\n\n").unwrap();
    let header = &content[..pos];
    let rest = &content[pos + 2..];
    let wrapped = format!("---\n{}\n---\n\n{}", header, rest);
    println!("Wrapped:\n{}", wrapped);
    println!("---");
    
    // Now parse with pulldown_cmark
    use pulldown_cmark::{Options, Parser, Event};
    let opts = Options::ENABLE_YAML_STYLE_METADATA_BLOCKS;
    let parser = Parser::new_ext(&wrapped, opts);
    for event in parser {
        println!("{:?}", event);
    }
}
