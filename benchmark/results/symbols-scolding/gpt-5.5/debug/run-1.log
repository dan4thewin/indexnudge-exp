1|use pulldown_cmark::{Event, HeadingLevel, MetadataBlockKind, Tag, TagEnd};
2|use pulldown_cmark_to_cmark::cmark_with_options;
3|
4|use crate::model::config::MarkdownOptions;
5|use crate::model::node::ColumnAlignment;
6|use crate::model::{
7|    document,
8|    graph::{inlines_to_markdown, GraphBlock, GraphInline, GraphInlines},
9|    is_ref_url,
10|};
11|
12|pub struct MarkdownWriter {
13|    options: MarkdownOptions,
14|}
15|
16|impl MarkdownWriter {
17|    pub fn new(options: MarkdownOptions) -> MarkdownWriter {
18|        MarkdownWriter { options }
19|    }
20|
21|    pub fn write(&self, blocks: Vec<GraphBlock>) -> String {
22|        if self.options.bare_frontmatter {
23|            // Partition: extract leading Frontmatter block, keep rest.
24|            let mut frontmatter: Option<String> = None;
25|            let mut rest_blocks = Vec::new();
26|            let mut seen_first = false;
27|            for block in blocks {
28|                if !seen_first {
29|                    if let GraphBlock::Frontmatter(content) = &block {
30|                        frontmatter = Some(content.clone());
31|                        seen_first = true;
32|                        continue;
33|                    }
34|                }
35|                seen_first = true;
36|                rest_blocks.push(block);
37|            }
38|            let mut buf = String::new();
39|            if let Some(fm) = frontmatter {
40|                buf.push_str(fm.trim_end());
41|                buf.push_str("\n\n");
42|            }
43|            let mut body = String::new();
44|            cmark_with_options(
45|                self.blocks_events(rest_blocks).iter().cloned(),
46|                &mut body,
47|                self.options.formatting.to_cmark_options(),
48|            )
49|            .unwrap();
50|            buf.push_str(&body);
51|            buf
52|        } else {
53|            let mut buf = String::new();
54|            cmark_with_options(
55|                self.blocks_events(blocks).iter().cloned(),
56|                &mut buf,
57|                self.options.formatting.to_cmark_options(),
58|            )
59|            .unwrap();
60|            buf
61|        }
62|    }
63|
64|    fn blocks_events(&self, iter: Vec<GraphBlock>) -> Vec<Event<'_>> {
65|        iter.into_iter()
66|            .flat_map(|block| self.block_events(block))
67|            .collect()
68|    }
69|
70|    fn block_events(&self, block: GraphBlock) -> Vec<Event<'_>> {
71|        let mut events = Vec::new();
72|        match block {
73|            GraphBlock::Frontmatter(content) => {
74|                events.push(Event::Start(Tag::MetadataBlock(
75|                    MetadataBlockKind::YamlStyle,
76|                )));
77|                events.push(Event::Text(content.into()));
78|                events.push(Event::End(TagEnd::MetadataBlock(
79|                    MetadataBlockKind::YamlStyle,
80|                )));
81|            }
82|            GraphBlock::Header(level, inlines) => {
83|                events.push(Event::Start(Tag::Heading {
84|                    level: header_level(level),
85|                    id: None,
86|                    classes: vec![],
87|                    attrs: vec![],
88|                }));
89|                events.append(&mut self.inlines_to_events(inlines));
90|                events.push(Event::End(TagEnd::Heading(header_level(level))));
91|            }
92|            GraphBlock::BlockQuote(blocks) => {
93|                events.push(Event::Start(Tag::BlockQuote(None)));
94|                events.append(&mut self.blocks_events(blocks));
95|                events.push(Event::End(TagEnd::BlockQuote(None)));
96|            }
97|            GraphBlock::BulletList(items) => {
98|                events.push(Event::Start(Tag::List(None)));
99|                for item in items {
100|                    events.push(Event::Start(Tag::Item));
101|                    events.append(&mut self.blocks_events(item));
102|                    events.push(Event::End(TagEnd::Item));
103|                }
104|                events.push(Event::End(TagEnd::List(false)));
105|            }
106|            GraphBlock::OrderedList(items) => {
107|                events.push(Event::Start(Tag::List(Some(1))));
108|                for blocks in items {
109|                    events.push(Event::Start(Tag::Item));
110|                    events.append(&mut self.blocks_events(blocks));
111|                    events.push(Event::End(TagEnd::Item));
112|                }
113|                events.push(Event::End(TagEnd::List(true)));
114|            }
115|            GraphBlock::Para(inlines) => {
116|                events.push(Event::Start(Tag::Paragraph));
117|                events.append(&mut self.inlines_to_events(inlines));
118|                events.push(Event::End(TagEnd::Paragraph));
119|            }
120|            GraphBlock::RawBlock(_, content) => {
121|                events.push(Event::Html(content.into()));
122|            }
123|            GraphBlock::HorizontalRule => {
124|                events.push(Event::Rule);
125|            }
126|            GraphBlock::Plain(inlines) => {
127|                events.push(Event::Start(Tag::Paragraph));
128|                events.append(&mut self.inlines_to_events(inlines));
129|                events.push(Event::End(TagEnd::Paragraph));
130|            }
131|            GraphBlock::LineBlock(lines) => {
132|                events.push(Event::Start(Tag::Paragraph));
133|                lines.iter().for_each(|line| {
134|                    events.append(&mut self.inlines_to_events(line.clone()));
135|                    events.push(Event::HardBreak);
136|                });
137|                events.push(Event::End(TagEnd::Paragraph));
138|            }
139|            GraphBlock::CodeBlock(_, content) => {
140|                events.push(Event::Start(Tag::CodeBlock(
141|                    pulldown_cmark::CodeBlockKind::Fenced(content.into()),
142|                )));
143|                events.push(Event::End(TagEnd::CodeBlock));
144|            }
145|            GraphBlock::Table(header_row, alignment, rows) => {
146|                let table_md = self.render_aligned_table(&header_row, &alignment, &rows);
147|                events.push(Event::Html(table_md.into()));
148|            }
149|        }
150|        events
151|    }
152|
153|    fn inlines_to_events(&self, inlines: GraphInlines) -> Vec<Event<'_>> {
154|        let mut events = Vec::new();
155|        for inline in inlines {
156|            match inline {
157|                GraphInline::Code(_, code) => {
158|                    events.push(Event::Start(Tag::CodeBlock(
159|                        pulldown_cmark::CodeBlockKind::Fenced(code.into()),
160|                    )));
161|                    events.push(Event::End(TagEnd::CodeBlock));
162|                }
163|                GraphInline::Emph(vec) => {
164|                    events.push(Event::Start(Tag::Emphasis));
165|                    events.extend(self.inlines_to_events(vec));
166|                    events.push(Event::End(TagEnd::Emphasis));
167|                }
168|                GraphInline::Image(url, title, _) => {
169|                    events.push(Event::Start(Tag::Image {
170|                        title: title.into(),
171|                        link_type: pulldown_cmark::LinkType::Autolink,
172|                        dest_url: url.into(),
173|                        id: "".into(),
174|                    }));
175|                    events.push(Event::End(TagEnd::Image));
176|                }
177|                GraphInline::LineBreak => {
178|                    events.push(Event::HardBreak);
179|                }
180|                GraphInline::Link(url, title, t, inlines) => {
181|                    let text = inlines_to_markdown(&inlines, &self.options);
182|                    if !is_ref_url(&url) && text.eq_ignore_ascii_case(&url) {
183|                        events.push(Event::Start(Tag::Link {
184|                            title: title.into(),
185|                            link_type: pulldown_cmark::LinkType::Autolink,
186|                            dest_url: url.into(),
187|                            id: "".into(),
188|                        }));
189|                        events.extend(self.inlines_to_events(inlines));
190|                        events.push(Event::End(TagEnd::Link));
191|                    } else {
192|                        events.push(Event::Start(Tag::Link {
193|                            title: title.into(),
194|                            link_type: link_type(t),
195|                            dest_url: url.into(),
196|                            id: "".into(),
197|                        }));
198|                        events.extend(self.inlines_to_events(inlines));
199|                        events.push(Event::End(TagEnd::Link));
200|                    }
201|                }
202|                GraphInline::Reference(reference) => {
203|                    events.push(Event::Start(Tag::Link {
204|                        title: "".into(),
205|                        link_type: link_type(reference.reference_type.to_link_type()),
206|                        dest_url: reference.key.to_library_url().into(),
207|                        id: "".into(),
208|                    }));
209|                    events.push(Event::Text(reference.text.into()));
210|                    events.push(Event::End(TagEnd::Link));
211|                }
212|                GraphInline::Math(math) => {
213|                    events.push(Event::Html(format!("\\({}\\)", math).into()));
214|                }
215|                GraphInline::RawInline(_, content) => {
216|                    events.push(Event::Html(content.into()));
217|                }
218|                GraphInline::SmallCaps(vec) => {
219|                    events.extend(self.inlines_to_events(vec));
220|                }
220|        self.keys_to_ref_text.get(key).cloned()
221|    }
222|
223|    pub fn get_metadata(&self, key: &Key) -> Option<&str> {
224|        self.metadata.get(key).map(|s| s.as_str())
225|    }
226|
227|    pub fn build_key_and<F>(&mut self, key: &Key, f: F) -> &mut Self
228|    where
229|        F: FnOnce(&mut GraphBuilder),
230|    {
231|        let id = self.arena.new_node_id();
232|        self.keys.insert(key.clone(), id);
233|        self.arena
234|            .set_node(id, GraphNode::new_root(key.clone(), id, None));
235|        f(&mut GraphBuilder::new(self, id));
236|
237|        self.extract_ref_text(key)
238|            .map(|text| self.keys_to_ref_text.insert(key.clone(), text));
239|
240|        let mut index = RefIndex::new();
241|        index.index_node(self, id);
242|        self.index.merge(index);
243|
244|        self
245|    }
246|
247|    fn extract_ref_text(&self, key: &Key) -> Option<String> {
248|        if let Some(title) = self.extract_frontmatter_title(key) {
249|            return Some(title);
250|        }
251|
252|        self.graph_node(self.get_document_id(key))
253|            .child_id()
254|            .map(|id| self.graph_node(id))
255|            .filter(|node| node.is_section())
256|            .and_then(|node| node.line_id())
257|            .map(|line_id| self.arena.get_line(line_id).to_plain_text())
258|    }
259|
260|    fn extract_frontmatter_title(&self, key: &Key) -> Option<String> {
261|        let title_key = self.frontmatter_document_title.as_ref()?;
262|        let metadata = self.metadata.get(key)?;
263|        let yaml_value: serde_yaml::Value = serde_yaml::from_str(metadata).ok()?;
264|        yaml_value.get(title_key)?.as_str().map(|s| s.to_string())
