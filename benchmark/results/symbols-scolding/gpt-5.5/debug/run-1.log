5|pub fn to_indoc(state: &State) -> String {
6|    state
7|        .iter()
8|        .sorted_by_key(|a| a.0)
9|        .map(|file| file.1.to_string())
10|        .collect::<Vec<String>>()
11|        .join("_\n")
12|}
13|
14|pub fn from_indoc(indoc: &str) -> State {
15|    indoc
16|        .split("\n_\n")
17|        .enumerate()
18|        .map(|(index, text)| ((index + 1).to_string(), text.trim().to_string()))
19|        .collect()
20|}
21|
22|pub fn from_indoc_sub(indoc: &str) -> State {
23|    indoc
24|        .split("\n_\n")
25|        .enumerate()
26|        .map(|(index, text)| {
27|            let name = if index == 0 {
28|                "1".to_string()
29|            } else {
30|                format!("d/{}", index + 1)
31|            };
32|            (name.to_string(), text.trim().to_string())
33|        })
34|        .collect()
35|}
36|
37|pub fn new_form_pairs(files: Vec<&str>) -> State {
38|    let pairs = files
39|        .iter()
40|        .enumerate()
41|        .filter(|(i, _)| i % 2 == 0)
42|        .map(|(_, name)| name)
43|        .zip(
44|            files
45|                .iter()
46|                .enumerate()
47|                .filter(|(i, _)| i % 2 == 1)
48|                .map(|(_, content)| content),
49|        );
50|
51|    pairs
52|        .map(|(name, content)| (name.to_string(), content.to_string()))
53|        .collect()
54|}
