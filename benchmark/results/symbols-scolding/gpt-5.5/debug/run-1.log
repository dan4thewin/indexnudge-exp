3|
4|pub fn get_iwe_binary_path() -> PathBuf {
5|    let mut binary_path = env::current_dir().expect("Failed to get current directory");
6|
7|    while !binary_path.join("Cargo.toml").exists() || !binary_path.join("crates").exists() {
8|        if !binary_path.pop() {
9|            panic!("Could not find workspace root");
10|        }
11|    }
12|
13|    binary_path.push("target");
14|
15|    ["debug", "release"]
16|        .into_iter()
17|        .map(|x| binary_path.join(x).join("iwe"))
18|        .find(|x| x.exists())
19|        .unwrap_or_else(|| panic!("Could not find iwe binary"))
20|}
1|use indoc::indoc;
2|use liwe::model::config::{Configuration, LibraryOptions, MarkdownOptions};
3|use std::fs::{create_dir_all, write};
4|use std::process::Command;
5|use tempfile::TempDir;
6|
7|mod common;
8|
9|fn setup_workspace() -> TempDir {
10|    let temp_dir = TempDir::new().expect("Failed to create temp directory");
11|    let temp_path = temp_dir.path();
12|
13|    create_dir_all(temp_path.join(".iwe")).expect("Failed to create .iwe directory");
14|
15|    let config = Configuration {
16|        library: LibraryOptions {
17|            path: "".to_string(),
18|            ..Default::default()
19|        },
20|        markdown: MarkdownOptions {
21|            refs_extension: "".to_string(),
22|            ..Default::default()
23|        },
24|        ..Default::default()
25|    };
26|
27|    let config_content = toml::to_string(&config).expect("Failed to serialize config to TOML");
28|    write(temp_path.join(".iwe").join("config.toml"), config_content)
29|        .expect("Should write config file");
30|
31|    temp_dir
32|}
33|
34|fn run_iwe(dir: &std::path::Path, args: &[&str]) -> (String, String, bool) {
35|    let mut command = Command::new(common::get_iwe_binary_path());
36|    command.arg("find").current_dir(dir);
37|
38|    for arg in args {
39|        command.arg(arg);
40|    }
41|
42|    let output = command.output().expect("Failed to execute command");
43|
44|    let stdout = String::from_utf8_lossy(&output.stdout).to_string();
45|    let stderr = String::from_utf8_lossy(&output.stderr).to_string();
46|    let success = output.status.success();
47|
48|    (stdout, stderr, success)
