215|    fn start_tag(&mut self, tag: Tag, range: Range<usize>) {
216|        match tag {
217|            Tag::Paragraph => {
218|                self.push_block(DocumentBlock::Para(Para {
219|                    line_range: self.to_line_range(range),
220|                    inlines: vec![],
221|                }));
222|            }
223|            Tag::Heading { level, .. } => self.push_block(DocumentBlock::Header(Header {
224|                line_range: self.to_line_range(range),
225|                level: level as u8,
226|                inlines: vec![],
227|            })),
228|            Tag::BlockQuote(_) => self.push_block(DocumentBlock::BlockQuote(BlockQuote {
229|                line_range: self.to_line_range(range),
230|                blocks: Vec::new(),
231|            })),
232|            Tag::CodeBlock(code_block_kind) => {
233|                self.push_block(DocumentBlock::CodeBlock(CodeBlock {
234|                    line_range: self.to_line_range(range),
235|                    lang: match code_block_kind {
236|                        CodeBlockKind::Fenced(lang) => {
237|                            Some(lang.to_string()).filter(|f| !f.is_empty())
238|                        }
239|                        CodeBlockKind::Indented => None,
240|                    },
241|                    text: String::default(),
242|                }))
243|            }
244|            Tag::HtmlBlock => {}
245|            Tag::List(num) => {
246|                let line_range = self.to_line_range(range);
247|                if num.is_some() {
248|                    self.push_block(DocumentBlock::OrderedList(OrderedList {
249|                        line_range,
250|                        items: vec![],
251|                    }));
252|                } else {
253|                    self.push_block(DocumentBlock::BulletList(BulletList {
254|                        line_range,
255|                        items: vec![],
256|                    }));
257|                }
258|            }
259|            Tag::Item => {
260|                self.top_block().append_item();
261|            }
262|            Tag::FootnoteDefinition(_) => {}
263|            Tag::DefinitionList => {}
264|            Tag::DefinitionListTitle => {}
265|            Tag::DefinitionListDefinition => {}
266|            Tag::Table(alignment) => {
267|                self.push_block(DocumentBlock::Table(Table {
268|                    line_range: self.to_line_range(range),
269|                    alignment: alignment
270|                        .iter()
271|                        .map(|a| match a {
272|                            Alignment::None => ColumnAlignment::None,
273|                            Alignment::Left => ColumnAlignment::Left,
274|                            Alignment::Center => ColumnAlignment::Center,
275|                            Alignment::Right => ColumnAlignment::Right,
276|                        })
277|                        .collect(),
278|                    rows: vec![],
279|                    header: vec![],
280|                }));
281|            }
282|            Tag::TableHead => {}
283|            Tag::TableRow => {
284|                self.top_block().append_row();
285|            }
286|            Tag::TableCell => {
287|                self.top_block().append_cell();
288|            }
289|            Tag::Emphasis => {
290|                self.push_inline(
291|                    DocumentInline::Emph(Emph {
292|                        inlines: vec![],
293|                        inline_range: self.to_inline_range(range.clone()),
294|                    }),
295|                    self.to_line_range(range),
296|                );
297|            }
298|            Tag::Strong => {
299|                self.push_inline(
300|                    DocumentInline::Strong(Strong {
301|                        inlines: vec![],
302|                        inline_range: self.to_inline_range(range.clone()),
303|                    }),
304|                    self.to_line_range(range),
305|                );
306|            }
307|            Tag::Strikethrough => {
308|                self.push_inline(
309|                    DocumentInline::Strikeout(Strikeout {
310|                        inlines: vec![],
311|                        inline_range: self.to_inline_range(range.clone()),
312|                    }),
313|                    self.to_line_range(range),
314|                );
315|            }
316|            Tag::Link {
317|                dest_url,
318|                title,
319|                link_type,
320|                id: _,
321|            } => {
322|                self.push_inline(
323|                    DocumentInline::Link(Link {
324|                        inlines: vec![],
325|                        target: Target {
326|                            url: normalize_url(
327|                                dest_url.as_ref(),
328|                                &self.markdown_options.refs_extension,
329|                            ),
330|                            title: title.to_string(),
331|                        },
332|                        title: title.to_string(),
333|                        attr: Default::default(),
334|                        inline_range: self.to_inline_range(range.clone()),
335|                        link_type: to_link_type(link_type),
336|                    }),
337|                    self.to_line_range(range),
338|                );
339|            }
340|            Tag::Image {
341|                dest_url, title, ..
342|            } => {
343|                self.push_inline(
344|                    DocumentInline::Image(Image {
345|                        inlines: vec![],
346|                        target: Target {
347|                            url: dest_url.to_string(),
348|                            title: title.to_string(),
349|                        },
350|                        attr: Default::default(),
351|                        inline_range: self.to_inline_range(range.clone()),
352|                    }),
353|                    self.to_line_range(range),
354|                );
355|            }
356|            Tag::MetadataBlock(_) => self.metadata_block = true,
357|            Tag::Superscript => {}
358|            Tag::Subscript => {}
359|        }
360|    }
361|
362|    fn end_tag(&mut self, tag: TagEnd, _: Range<usize>) {
363|        match tag {
364|            TagEnd::Paragraph => {
365|                self.pop_block();
366|            }
367|            TagEnd::Heading(_) => self.pop_block(),
368|            TagEnd::BlockQuote(_) => self.pop_block(),
369|            TagEnd::CodeBlock => {
370|                self.pop_block();
371|            }
372|            TagEnd::HtmlBlock => {}
373|            TagEnd::List(_) => {
374|                self.pop_block();
375|            }
376|            TagEnd::Item => {}
377|            TagEnd::Emphasis => self.pop_inline(),
378|            TagEnd::Strong => self.pop_inline(),
379|            TagEnd::Strikethrough => self.pop_inline(),
380|            TagEnd::Link => self.pop_inline(),
381|            TagEnd::DefinitionList => {}
382|            TagEnd::DefinitionListDefinition => {}
383|            TagEnd::DefinitionListTitle => {}
384|            TagEnd::FootnoteDefinition => {}
385|            TagEnd::Image => self.pop_inline(),
386|            TagEnd::MetadataBlock(_) => self.metadata_block = false,
387|            TagEnd::Table => {
388|                self.pop_block();
389|            }
390|            TagEnd::TableCell => {}
391|            TagEnd::TableHead => {}
392|            TagEnd::TableRow => {}
393|            TagEnd::Superscript => {}
394|            TagEnd::Subscript => {}
395|        }
396|    }
