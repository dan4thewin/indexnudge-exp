25|
26|/// If `bare_frontmatter` is enabled and content starts with a YAML mapping
27|/// (but not `---`), wrap the leading metadata block in `---` fences so the
28|/// downstream pulldown-cmark MetadataBlock machinery picks it up.
29|pub fn wrap_bare_frontmatter(content: &str) -> Cow<'_, str> {
30|    // Already fenced — leave alone.
31|    if content.starts_with("---") {
32|        return Cow::Borrowed(content);
33|    }
34|
35|    // Find first true blank line (\n\n or \r\n\r\n).
36|    let (header, rest) = if let Some(pos) = content.find("\n\n") {
37|        (&content[..pos], &content[pos + 2..])
38|    } else if let Some(pos) = content.find("\r\n\r\n") {
39|        (&content[..pos], &content[pos + 4..])
40|    } else {
41|        // No blank line — entire content is a metadata candidate.
42|        (content, "")
43|    };
44|
45|    let header = header.trim_end();
46|    if !is_bare_frontmatter(header) {
47|        return Cow::Borrowed(content);
48|    }
49|
50|    if rest.is_empty() {
51|        Cow::Owned(format!("---\n{}\n---\n", header))
52|    } else {
53|        Cow::Owned(format!("---\n{}\n---\n\n{}", header, rest))
54|    }
55|}
56|
57|fn is_bare_frontmatter(header: &str) -> bool {
58|    if header.trim().is_empty() {
59|        return false;
60|    }
61|
62|    if !header.lines().any(is_metadata_key_line) {
63|        return false;
64|    }
65|
66|    match serde_yaml::from_str::<serde_yaml::Value>(header) {
67|        Ok(serde_yaml::Value::Mapping(mapping)) => !mapping.is_empty(),
68|        _ => false,
69|    }
70|}
71|
72|fn is_metadata_key_line(line: &str) -> bool {
73|    if line.starts_with(' ') || line.starts_with('\t') {
74|        return false;
75|    }
76|
77|    let Some((key, _)) = line.split_once(':') else {
78|        return false;
79|    };
80|
81|    !key.is_empty()
82|        && key
83|            .chars()
84|            .all(|c| c.is_ascii_alphanumeric() || c == '_' || c == '-')
85|}
