ed -s crates/iwe/tests/find_test.rs <<'EOF'
495a

#[test]
fn test_find_count_lists_only_total() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}

#[test]
fn test_find_count_respects_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join("parent.md"),
        indoc! {"
            ---
            status: ready
            ---
            # Parent

            [child](child)
        "},
    )
    .unwrap();

    write(
        dir.path().join("child.md"),
        indoc! {"
            ---
            status: ready
            ---
            # Child
        "},
    )
    .unwrap();

    write(
        dir.path().join("done.md"),
        indoc! {"
            ---
            status: done
            ---
            # Done
        "},
    )
    .unwrap();

    let (stdout, stderr, success) =
        run_iwe(dir.path(), &["--count", "--roots", "--meta", "status=ready"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "1\n");
}

#[test]
fn test_find_count_ignores_limit() {
    let dir = setup_workspace();

    for i in 1..=5 {
        write(
            dir.path().join(format!("doc{}.md", i)),
            format!("# Document {}\n\nContent.", i),
        )
        .unwrap();
    }

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count", "--limit", "2"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "5\n");
}
.
w
