34|fn run_iwe(dir: &std::path::Path, args: &[&str]) -> (String, String, bool) {
35|    let mut command = Command::new(common::get_iwe_binary_path());
36|    command.arg("find").current_dir(dir);
37|
38|    for arg in args {
39|        command.arg(arg);
40|    }
41|
42|    let output = command.output().expect("Failed to execute command");
43|
44|    let stdout = String::from_utf8_lossy(&output.stdout).to_string();
45|    let stderr = String::from_utf8_lossy(&output.stderr).to_string();
46|    let success = output.status.success();
47|
48|    (stdout, stderr, success)
