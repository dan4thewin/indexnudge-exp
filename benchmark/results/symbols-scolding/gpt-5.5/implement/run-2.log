670|fn find_command(args: Find) {
671|    let config = get_configuration();
672|    let graph = load_graph(&config);
673|
674|    let finder = DocumentFinder::new(&graph);
675|    let options = FindOptions {
676|        query: args.query,
677|        roots: args.roots,
678|        refs_to: args.refs_to.map(|s| Key::name(&s)),
679|        refs_from: args.refs_from.map(|s| Key::name(&s)),
680|        selector: args.selector.into(),
681|        limit: args.limit,
682|        metadata_filters: args.meta,
683|    };
684|
