47|                    format!("{}/{}", parent.to_string_lossy(), to_file_name(path, strip_underscore))
48|                }
49|            } else {
50|                to_file_name(path, strip_underscore)
51|            };
52|
53|            fs::read_to_string(path).ok().map(|content| (key, content))
54|        })
55|        .collect()
