32|        .require_git(false)
33|        .build()
34|        .filter_map(|entry| {
35|            let entry = entry.ok()?;
36|            let path = entry.path();
37|
38|            if !path.is_file() || path.extension().is_none_or(|ext| ext != "md") {
39|                return None;
40|            }
41|
42|            let relative_path = path.strip_prefix(base_path).ok()?;
