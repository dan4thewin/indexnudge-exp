48|            inlines_pos_stack: Vec::new(),
49|            inlines_stack: Vec::new(),
50|            blocks_stack: Vec::new(),
51|            blocks: Vec::new(),
52|            line_starts: Vec::new(),
53|            metadata_block: false,
54|            metadata: None,
55|            content: None,
56|        }
57|    }
58|
59|    pub fn blocks(&self) -> Vec<DocumentBlock> {
60|        self.blocks.clone()
61|    }
62|
63|    pub fn metadata(&self) -> Option<String> {
64|        self.metadata.clone()
65|    }
66|
67|    pub fn top_block(&mut self) -> &mut DocumentBlock {
68|        self.blocks_stack.last_mut().unwrap_or_else(|| {
69|            panic!(
70|                "parse markdown:\n{}",
71|                &self.content.clone().unwrap_or_default()
72|            )
73|        })
74|    }
75|
76|    pub fn read(&mut self, content: &str) -> DocumentBlocks {
77|        self.content = Some(content.to_string());
78|        let iter = Parser::new_ext(
79|            content,
80|            Options::ENABLE_YAML_STYLE_METADATA_BLOCKS
81|                | Options::ENABLE_WIKILINKS
82|                | Options::ENABLE_TABLES,
83|        )
84|        .into_offset_iter();
85|        self.line_starts = line_starts(content);
86|
87|        for (event, range) in iter {
88|            match event {
89|                Start(tag) => {
90|                    self.start_tag(tag, range);
91|                }
92|                End(tag) => {
93|                    self.end_tag(tag, range);
94|                }
95|                Text(text) => {
96|                    if !self.metadata_block {
97|                        match self.top_block() {
98|                            DocumentBlock::CodeBlock(code_block) => {
99|                                code_block.text = format!("{}{}", code_block.text, text)
100|                            }
101|                            DocumentBlock::RawBlock(block) => block.text = text.to_string(),
102|                            _ => {
103|                                self.push_inline(
104|                                    DocumentInline::Str(text.to_string()),
105|                                    self.to_line_range(range),
106|                                );
107|                                self.pop_inline();
108|                            }
109|                        }
110|                    } else {
111|                        self.metadata = Some(text.to_string());
112|                    }
113|                }
114|                Code(text) => {
115|                    self.push_inline(
116|                        DocumentInline::Code(document::Code {
117|                            attr: Attributes::default(),
118|                            text: text.to_string(),
119|                            inline_range: self.to_inline_range(range.clone()),
120|                        }),
---
340|            Tag::Image {
341|                dest_url, title, ..
342|            } => {
343|                self.push_inline(
344|                    DocumentInline::Image(Image {
345|                        inlines: vec![],
346|                        target: Target {
347|                            url: dest_url.to_string(),
348|                            title: title.to_string(),
349|                        },
350|                        attr: Default::default(),
351|                        inline_range: self.to_inline_range(range.clone()),
352|                    }),
353|                    self.to_line_range(range),
354|                );
355|            }
356|            Tag::MetadataBlock(_) => self.metadata_block = true,
357|            Tag::Superscript => {}
358|            Tag::Subscript => {}
359|        }
360|    }
361|
362|    fn end_tag(&mut self, tag: TagEnd, _: Range<usize>) {
363|        match tag {
364|            TagEnd::Paragraph => {
365|                self.pop_block();
366|            }
367|            TagEnd::Heading(_) => self.pop_block(),
368|            TagEnd::BlockQuote(_) => self.pop_block(),
369|            TagEnd::CodeBlock => {
370|                self.pop_block();
371|            }
372|            TagEnd::HtmlBlock => {}
373|            TagEnd::List(_) => {
374|                self.pop_block();
375|            }
376|            TagEnd::Item => {}
377|            TagEnd::Emphasis => self.pop_inline(),
378|            TagEnd::Strong => self.pop_inline(),
379|            TagEnd::Strikethrough => self.pop_inline(),
380|            TagEnd::Link => self.pop_inline(),
381|            TagEnd::DefinitionList => {}
382|            TagEnd::DefinitionListDefinition => {}
383|            TagEnd::DefinitionListTitle => {}
384|            TagEnd::FootnoteDefinition => {}
385|            TagEnd::Image => self.pop_inline(),
386|            TagEnd::MetadataBlock(_) => self.metadata_block = false,
387|            TagEnd::Table => {
388|                self.pop_block();
389|            }
390|            TagEnd::TableCell => {}
