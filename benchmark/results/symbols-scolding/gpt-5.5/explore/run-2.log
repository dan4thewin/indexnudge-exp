30|impl MarkdownEventsReader {
31|    pub fn new() -> MarkdownEventsReader {
32|        MarkdownEventsReader {
33|            markdown_options: MarkdownOptions::default(),
34|            inlines_pos_stack: Vec::new(),
35|            inlines_stack: Vec::new(),
