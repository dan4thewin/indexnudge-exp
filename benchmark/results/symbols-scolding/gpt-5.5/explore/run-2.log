569|#[tracing::instrument(level = "debug")]
570|fn retrieve_command(args: Retrieve) {
571|    let config = get_configuration();
572|    let graph = load_graph(&config);
573|
574|    let selector_args = args.selector.clone();
575|    let selector_provided = !selector_args.in_.is_empty()
576|        || !selector_args.in_any.is_empty()
577|        || !selector_args.not_in.is_empty()
578|        || selector_args.max_depth.is_some();
579|
580|    let key_strings: Vec<String> = if args.key.is_empty() {
581|        let stdin_content = read_stdin_if_available();
582|        let keys: Vec<String> = stdin_content
583|            .lines()
584|            .map(|s| s.trim().to_string())
585|            .filter(|s| !s.is_empty())
586|            .collect();
587|        if keys.is_empty() && !selector_provided {
588|            eprintln!("Error: No document key provided. Use -k <key>, --in <key>, or pipe keys via stdin.");
589|            std::process::exit(1);
590|        }
591|        keys
592|    } else {
593|        args.key
594|    };
595|
596|    let mut keys = Vec::new();
597|    for key_str in &key_strings {
598|        let key = Key::name(key_str);
599|        if (&graph).get_node_id(&key).is_none() {
600|            eprintln!("Error: Document '{}' not found", key_str);
601|            std::process::exit(2);
602|        }
603|        keys.push(key);
604|    }
605|
606|    let reader = DocumentReader::new(&graph);
607|    let exclude: std::collections::HashSet<Key> = args
608|        .exclude
609|        .iter()
610|        .map(|s| Key::name(s))
611|        .collect();
612|    let options = RetrieveOptions {
613|        depth: args.depth,
614|        context: args.context,
615|        links: args.links,
616|        backlinks: args.backlinks,
617|        exclude,
618|        no_content: args.no_content,
619|        selector: args.selector.into(),
620|    };
621|
622|    let output = reader.retrieve_many(&keys, &options);
623|
624|    if args.dry_run {
625|        let doc_count = output.documents.len();
626|        let total_lines: usize = output
627|            .documents
628|            .iter()
629|            .map(|doc| doc.content.lines().count())
630|            .sum();
631|        println!("documents: {}", doc_count);
632|        println!("lines: {}", total_lines);
633|        return;
634|    }
635|
636|    match args.format {
637|        RetrieveFormat::Json => {
638|            let json = serde_json::to_string_pretty(&output).expect("Failed to serialize to JSON");
639|            println!("{}", json);
640|        }
641|        RetrieveFormat::Keys => {
642|            for doc in &output.documents {
643|                println!("{}", doc.key);
644|            }
645|        }
646|        RetrieveFormat::Markdown => {
647|            let options = graph.markdown_options();
648|            let renderer = RetrieveRenderer::new(&output, &options, &graph);
649|            print!("{}", renderer.render());
650|        }
651|    }
652|}
