280|    pub fn from_markdown(&mut self, key: Key, content: &str, reader: impl Reader) {
281|        let document = reader.document(content, &self.markdown_options);
282|
283|        if let Some(meta) = document.metadata {
284|            self.metadata.insert(key.clone(), meta);
285|        } else {
286|            self.metadata.remove(&key);
287|        }
288|
289|        let mut build_key = self.build_key(&key);
290|        let id = build_key.id();
291|
292|        let nodes_map = SectionsBuilder::new(&mut build_key, &document.blocks, &key).nodes_map();
293|
294|        self.nodes_map.insert(key.clone(), nodes_map.clone());
295|        self.global_nodes_map.extend(nodes_map);
296|
297|        let mut index = RefIndex::new();
298|        index.index_node(self, id);
299|        self.index.merge(index);
300|
301|        self.extract_ref_text(&key)
302|            .map(|text| self.keys_to_ref_text.insert(key, text));
303|    }
