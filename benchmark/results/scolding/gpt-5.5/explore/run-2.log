1613|            }
1614|        }
1615|        return;
1616|    }
1617|
1618|    if args.to.is_empty() {
1619|        eprintln!("Error: --to <ACTION> is required when not in --list mode (repeatable)");
1620|        std::process::exit(1);
1621|    }
1622|    let source_key_str = args.key.clone().unwrap_or_else(|| {
1623|        eprintln!("Error: --key is required when not in --list mode");
1624|        std::process::exit(1)
1625|    });
1626|    let source_key = Key::name(&source_key_str);
1627|
1628|    let graph = load_graph(&config);
1629|    if (&graph).get_node_id(&source_key).is_none() {
1630|        eprintln!("Error: Source document '{}' not found", source_key_str);
1631|        std::process::exit(1);
1632|    }
1633|
1634|    let reference_text = (&graph)
1635|        .get_key_title(&source_key)
1636|        .unwrap_or_else(|| source_key_str.clone());
1637|
1638|    let library_path = get_library_path(&config);
1639|
1640|    for action_name in &args.to {
1641|        let attach = match config.actions.get(action_name) {
1642|            Some(ActionDefinition::Attach(a)) => a.clone(),
1643|            Some(_) => {
1644|                eprintln!("Error: Action '{}' is not an attach action", action_name);
1645|                std::process::exit(1);
1646|            }
1647|            None => {
1648|                eprintln!("Error: Action '{}' not found", action_name);
1649|                std::process::exit(1);
1650|            }
1651|        };
1652|
1653|        let target_key_str = render_key_template(&attach.key_template);
1654|        let target_key = Key::name(&target_key_str);
1655|
1656|        if (&graph).get_node_id(&target_key).is_some() {
1657|            let tree = (&graph).collect(&target_key);
1658|            if tree.get_all_block_reference_keys().contains(&source_key) {
1659|                continue;
1660|            }
1661|        }
1662|
1663|        if args.dry_run {
1664|            if !args.quiet {
1665|                println!(
1666|                    "Would attach '{}' to '{}' as [{}]({})",
1667|                    source_key_str, target_key, reference_text, source_key_str
1668|                );
1669|            }
1670|            continue;
1671|        }
1672|
1673|        let target_path = library_path.join(format!("{}.md", target_key));
1674|        let line = format!("[{}]({})\n", reference_text, source_key);
1675|
1676|        if let Some(parent) = target_path.parent() {
1677|            std::fs::create_dir_all(parent).ok();
1678|        }
1679|
1680|        if target_path.exists() {
1681|            let mut existing = std::fs::read_to_string(&target_path)
1682|                .expect("Failed to read existing target file");
1683|            if !existing.ends_with('\n') {
1684|                existing.push('\n');
1685|            }
1686|            existing.push('\n');
1687|            existing.push_str(&line);
1688|            std::fs::write(&target_path, existing).expect("Failed to write target file");
1689|        } else {
1690|            let title = render_attach_title(&attach.title);
1691|            let initial = format!("# {}\n\n{}", title, line);
1692|            std::fs::write(&target_path, initial).expect("Failed to write target file");
1693|        }
1694|
1695|        if !args.quiet {
1696|            println!(
1697|                "Attached '{}' to '{}' as [{}]",
1698|                source_key_str, target_key, reference_text
1699|            );
1700|        }
1701|    }
