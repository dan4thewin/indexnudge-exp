1704|fn render_key_template(template: &str) -> String {
1705|    use chrono::Local;
1706|    use minijinja::{context, Environment};
1707|    let now = Local::now();
1708|    let formatted = now.format("%Y-%m-%d").to_string();
1709|    Environment::new()
1710|        .template_from_str(template)
1711|        .expect("valid key template")
1712|        .render(context! {
1713|            today => &formatted,
1714|            now => &formatted,
1715|        })
1716|        .expect("key template to render")
1717|}
1718|
1719|fn render_attach_title(template: &str) -> String {
1720|    use chrono::Local;
1721|    use minijinja::{context, Environment};
1722|    let now = Local::now();
