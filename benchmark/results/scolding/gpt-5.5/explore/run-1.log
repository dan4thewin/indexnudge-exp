CREATE TABLE calls (
            caller_file   TEXT,
            caller_symbol TEXT,
            callee        TEXT,
            callee_qname  TEXT,
            kind          TEXT,
            line_num      INTEGER
        );
CREATE TABLE defs (
            symbol TEXT,
            file   TEXT,
            line_num INTEGER,
            var    TEXT,
            kind   TEXT
        );
CREATE TABLE imports (
            file   TEXT,
            module TEXT,
            line_num INTEGER
        );
