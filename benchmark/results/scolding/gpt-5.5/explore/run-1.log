69|fn to_file_name(path: &Path, strip_underscore: bool) -> String {
70|    let name = path
71|        .file_name()
72|        .map(|name| name.to_string_lossy().trim_end_matches(".md").to_string())
73|        .unwrap_or_default();
74|
75|    // Strip leading `_` only for virtual directory index files
76|    if strip_underscore && name.starts_with('_') {
77|        name[1..].to_string()
78|    } else {
79|        name
80|    }
