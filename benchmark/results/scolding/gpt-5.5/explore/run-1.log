654|fn parse_meta_filter(s: &str) -> Result<(String, String), String> {
655|    s.split_once('=')
656|        .map(|(k, v)| (k.trim().to_string(), v.trim().to_string()))
657|        .ok_or_else(|| format!("expected key=value, got `{}`", s))
658|}
