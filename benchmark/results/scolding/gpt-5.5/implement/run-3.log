119|                .collect()
120|        } else {
121|            results
122|                .into_iter()
123|                .map(|(key, _)| self.build_result(&key))
124|                .collect()
125|        };
126|
127|        let limit = options.limit.filter(|&l| l < total);
128|
129|        FindOutput {
130|            query: options.query.clone(),
131|            limit,
132|            total,
133|            results,
134|        }
135|    }
