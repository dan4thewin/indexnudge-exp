#[test]
fn test_find_count() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}

#[test]
fn test_find_count_with_filters_and_limit() {
    let dir = setup_workspace();

    write(
        dir.path().join("parent1.md"),
        indoc! {"
            ---
            status: active
            ---
            # Parent One

            [target](target)
        "},
    )
    .unwrap();

    write(
        dir.path().join("parent2.md"),
        indoc! {"
            ---
            status: active
            ---
            # Parent Two

            [target](target)
        "},
    )
    .unwrap();

    write(
        dir.path().join("inactive.md"),
        indoc! {"
            ---
            status: inactive
            ---
            # Inactive

            [target](target)
        "},
    )
    .unwrap();

    write(dir.path().join("target.md"), "# Target\n\nTarget content.").unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &[
            "--refs-to",
            "target",
            "--meta",
            "status=active",
            "--limit",
            "1",
            "--count",
            "-f",
            "json",
        ],
    );

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}
.
