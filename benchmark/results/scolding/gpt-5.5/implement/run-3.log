695|fn render_find_output(output: &iwe::find::FindOutput) -> String {
696|    let mut result = String::new();
697|
698|    result.push_str(&format!("Found {} results", output.total));
699|    if let Some(ref query) = output.query {
700|        result.push_str(&format!(" for \"{}\"", query));
701|    }
702|    if let Some(limit) = output.limit {
703|        result.push_str(&format!(" (showing {})", limit));
704|    }
705|    result.push_str(":\n\n");
706|
707|    for r in &output.results {
708|        result.push_str(&format!("{}   #{}\n", r.display_title, r.key));
709|    }
710|
711|    result
712|}
