+sqlite3 .indexnudge-rust.db "SELECT file, line_num, content FROM lines WHERE file='...' AND line_num BETWEEN N AND M;"  # read lines
+sqlite3 .indexnudge-rust.db "SELECT * FROM lines_fts WHERE content MATCH '\"search_term\"';"  # full-text search
