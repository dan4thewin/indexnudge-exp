9|fn setup_workspace() -> TempDir {
10|    let temp_dir = TempDir::new().expect("Failed to create temp directory");
11|    let temp_path = temp_dir.path();
12|
13|    create_dir_all(temp_path.join(".iwe")).expect("Failed to create .iwe directory");
14|
15|    let config = Configuration {
16|        library: LibraryOptions {
17|            path: "".to_string(),
18|            ..Default::default()
19|        },
20|        markdown: MarkdownOptions {
21|            refs_extension: "".to_string(),
22|            ..Default::default()
23|        },
24|        ..Default::default()
25|    };
26|
27|    let config_content = toml::to_string(&config).expect("Failed to serialize config to TOML");
28|    write(temp_path.join(".iwe").join("config.toml"), config_content)
29|        .expect("Should write config file");
30|
31|    temp_dir
