15|    fn default() -> Self {
16|        Self::new()
17|    }
18|}
19|
20|impl MarkdownReader {
21|    pub fn new() -> MarkdownReader {
22|        MarkdownReader {}
23|    }
24|}
25|
26|/// If `bare_frontmatter` is enabled and content starts with `title: ` (but
27|/// not `---`), wrap the leading header block in `---` fences so the
28|/// downstream pulldown-cmark MetadataBlock machinery picks it up.
29|pub fn wrap_bare_frontmatter(content: &str) -> Cow<'_, str> {
30|    // Already fenced — leave alone.
31|    if content.starts_with("---") {
32|        return Cow::Borrowed(content);
33|    }
34|
35|    // Must start with `title: `.
36|    if !content.starts_with("title: ") {
37|        return Cow::Borrowed(content);
38|    }
39|
40|    // Find first true blank line (\n\n or \r\n\r\n).
41|    let (header, rest) = if let Some(pos) = content.find("\n\n") {
42|        (&content[..pos], &content[pos + 2..])
43|    } else if let Some(pos) = content.find("\r\n\r\n") {
44|        (&content[..pos], &content[pos + 4..])
45|    } else {
46|        // No blank line — entire content is header.
47|        (content.trim_end(), "")
48|    };
49|
50|    if rest.is_empty() {
51|        let cleaned_header: String = header
52|            .lines()
53|            .filter(|l| !l.starts_with(' '))
54|            .collect::<Vec<_>>()
55|            .join("\n");
56|        Cow::Owned(format!("---\n{}\n---\n", cleaned_header))
57|    } else {
58|        let cleaned_header: String = header
59|            .lines()
60|            .filter(|l| !l.starts_with(' '))
61|            .collect::<Vec<_>>()
62|            .join("\n");
63|        Cow::Owned(format!("---\n{}\n---\n\n{}", cleaned_header, rest))
64|    }
65|}
66|
67|impl Reader for MarkdownReader {
68|    fn document(&self, content: &str, markdown_options: &MarkdownOptions) -> Document {
69|        let effective = if markdown_options.bare_frontmatter {
70|            wrap_bare_frontmatter(content)
71|        } else {
72|            Cow::Borrowed(content)
73|        };
74|
75|        let mut reader = MarkdownEventsReader::new_with_options(markdown_options);
76|        reader.read(&effective);
77|
78|        Document {
79|            blocks: reader.blocks(),
80|            metadata: reader.metadata(),
81|        }
82|    }
83|}
