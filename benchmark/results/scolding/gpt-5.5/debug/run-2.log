60|fn run_iwe(dir: &std::path::Path, args: &[&str]) -> (String, String, bool) {
61|    let mut command = Command::new(common::get_iwe_binary_path());
62|    command.arg("find").current_dir(dir);
63|
64|    for arg in args {
65|        command.arg(arg);
66|    }
67|
68|    let output = command.output().expect("Failed to execute command");
69|
70|    let stdout = String::from_utf8_lossy(&output.stdout).to_string();
71|    let stderr = String::from_utf8_lossy(&output.stderr).to_string();
72|    let success = output.status.success();
73|
74|    (stdout, stderr, success)
