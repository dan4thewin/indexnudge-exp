fn test_find_meta_matches_bare_frontmatter_sequence() {
    let dir = setup_bare_frontmatter_workspace();

    write(
        dir.path().join("bare.md"),
        indoc! {"
            title: Bare
            depends:
              - foo
              - bar

            # Bare
        "},
    )
    .unwrap();

    write(
        dir.path().join("fenced.md"),
        indoc! {"
            ---
            title: Fenced
            depends:
              - foo
              - bar
            ---

            # Fenced
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--meta", "depends=foo", "-f", "keys"]);

    assert!(success, "stderr: {}", stderr);

    let keys: Vec<&str> = stdout.lines().collect();
    assert!(keys.contains(&"bare"), "bare frontmatter should match");
    assert!(keys.contains(&"fenced"), "fenced frontmatter should still match");
}
