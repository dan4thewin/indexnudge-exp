    28	/// downstream pulldown-cmark MetadataBlock machinery picks it up.
    29	pub fn wrap_bare_frontmatter(content: &str) -> Cow<'_, str> {
    30	    // Already fenced — leave alone.
    31	    if content.starts_with("---") {
    32	        return Cow::Borrowed(content);
    33	    }
    34	
    35	    // Must start with `title: `.
    36	    if !content.starts_with("title: ") {
    37	        return Cow::Borrowed(content);
    38	    }
    39	
    40	    // Find first true blank line (\n\n or \r\n\r\n).
    41	    let (header, rest) = if let Some(pos) = content.find("\n\n") {
    42	        (&content[..pos], &content[pos + 2..])
    43	    } else if let Some(pos) = content.find("\r\n\r\n") {
    44	        (&content[..pos], &content[pos + 4..])
    45	    } else {
    46	        // No blank line — entire content is header.
    47	        (content.trim_end(), "")
    48	    };
    49	
    50	    if rest.is_empty() {
    51	        Cow::Owned(format!("---\n{}\n---\n", header))
    52	    } else {
    53	        Cow::Owned(format!("---\n{}\n---\n\n{}", header, rest))
    54	    }
    55	}
