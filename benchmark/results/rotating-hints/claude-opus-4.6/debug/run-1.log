// Quick test to check if bare frontmatter metadata is parsed
use liwe::find::{DocumentFinder, FindOptions};
use liwe::graph::Graph;
use liwe::model::config::MarkdownOptions;
use liwe::state::from_indoc;
use indoc::indoc;

fn main() {
    let opts = MarkdownOptions { bare_frontmatter: true, ..Default::default() };
    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: Task A
            depends:
              - foo

            # Task A
        "}),
        opts,
        None,
    );
    
    // Check if metadata exists
