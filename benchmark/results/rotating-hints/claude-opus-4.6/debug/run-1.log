use pulldown_cmark::{Parser, Options, Event, Tag, TagEnd};

fn main() {
    let mut opts = Options::empty();
    opts.insert(Options::ENABLE_YAML_STYLE_METADATA_BLOCKS);
    
    // Test 1: fenced with list
    let fenced = "---\ntitle: Task A\ndepends:\n  - foo\n---\n\n# Task A\n";
    println!("=== fenced ===");
    for event in Parser::new_ext(fenced, opts) {
        match &event {
            Event::Start(Tag::MetadataBlock(_)) => println!("  MetadataBlock start"),
            Event::End(TagEnd::MetadataBlock(_)) => println!("  MetadataBlock end"),
            Event::Text(t) => println!("  Text: {:?}", t.as_ref()),
            _ => {}
        }
    }
    
    // Test 2: bare wrapped
    let bare_input = "title: Task A\ndepends:\n  - foo\n\n# Task A\n";
    // simulate wrap
    let pos = bare_input.find("\n\n").unwrap();
    let header = &bare_input[..pos];
    let rest = &bare_input[pos+2..];
    let wrapped = format!("---\n{}\n---\n\n{}", header, rest);
    println!("\n=== bare wrapped ===");
    println!("wrapped content: {:?}", wrapped);
    for event in Parser::new_ext(&wrapped, opts) {
        match &event {
            Event::Start(Tag::MetadataBlock(_)) => println!("  MetadataBlock start"),
            Event::End(TagEnd::MetadataBlock(_)) => println!("  MetadataBlock end"),
            Event::Text(t) => println!("  Text: {:?}", t.as_ref()),
            _ => {}
        }
    }
}
