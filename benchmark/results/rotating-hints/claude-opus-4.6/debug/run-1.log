fn setup_graph_bare(input: &str) -> Graph {
    Graph::import(
        &from_indoc(input),
        MarkdownOptions {
            bare_frontmatter: true,
            ..Default::default()
        },
        None,
    )
}

#[test]
fn bare_frontmatter_filters_by_string() {
    let graph = setup_graph_bare(indoc! {"
        title: Task A
        status: ready

        # Task A
    "});

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("status".to_string(), "ready".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "bare frontmatter string filter should match");
}

#[test]
fn bare_frontmatter_filters_by_sequence() {
    let graph = setup_graph_bare(indoc! {"
        title: Task A
        depends:
          - foo
          - bar

        # Task A
    "});

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "bare frontmatter sequence filter should match");
}
