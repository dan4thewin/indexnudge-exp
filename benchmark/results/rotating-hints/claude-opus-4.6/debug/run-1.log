use indoc::indoc;
use liwe::graph::Graph;
use liwe::model::config::MarkdownOptions;
use liwe::state::from_indoc;

fn bare_options() -> MarkdownOptions {
    MarkdownOptions {
        bare_frontmatter: true,
        ..Default::default()
    }
}

#[test]
fn debug_bare_metadata_content() {
    // Bare frontmatter with a YAML list
    let input = indoc! {"
        title: Task A
        depends:
          - foo

        # Task A
    "};

    let state = from_indoc(input);
    for (k, v) in &state {
        eprintln!("STATE key={} content={:?}", k, v);
    }

    let graph = Graph::import(&state, bare_options(), None);

    // Check what metadata the graph has
    use liwe::model::key::Key;
    let key = Key::name("1");
    let meta = graph.get_metadata(&key);
    eprintln!("METADATA for key 1: {:?}", meta);
}
