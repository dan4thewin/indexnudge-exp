use indoc::indoc;
use liwe::find::{DocumentFinder, FindOptions};
use liwe::graph::Graph;
use liwe::model::config::MarkdownOptions;
use liwe::state::from_indoc;
use std::collections::BTreeMap;

fn bare_options() -> MarkdownOptions {
    MarkdownOptions {
        bare_frontmatter: true,
        ..Default::default()
    }
}

#[test]
fn bare_meta_from_file_content() {
    // Simulate fs::read_to_string - content has trailing newline, NO trim
    let file_content = "title: Task A\ndepends:\n  - foo\n\n# Task A\n";
    
    let mut state: BTreeMap<String, String> = BTreeMap::new();
    state.insert("test".to_string(), file_content.to_string());
    
    let graph = Graph::import(&state, bare_options(), None);
    
    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "should find doc with depends=foo from raw file content");
}

#[test]
fn bare_meta_from_indoc_content() {
    // from_indoc trims content
    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: Task A
            depends:
              - foo

            # Task A
        "}),
        bare_options(),
        None,
    );
    
    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "should find doc with depends=foo from indoc");
}
