#[test]
fn bare_frontmatter_meta_filter_with_fdt() {
    let bare_opts = MarkdownOptions {
        bare_frontmatter: true,
        ..Default::default()
    };
    // With frontmatter_document_title set (like real config)
    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: Task A
            depends:
              - foo

            # Body
        "}),
        bare_opts,
        Some("title".to_string()),
    );

    for key in graph.keys() {
        let title = graph.get_key_title(&key).unwrap_or_default();
        let meta = graph.get_metadata(&key);
        eprintln!("key={} title={:?} meta={:?}", key, title, meta);
    }

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "should find doc with depends=foo");
}

#[test]
fn bare_frontmatter_created_first_line() {
    // What if 'created' is the first line instead of 'title'?
    let bare_opts = MarkdownOptions {
        bare_frontmatter: true,
        ..Default::default()
    };
    let graph = Graph::import(
        &from_indoc(indoc! {"
            created: 2026-01-01
            title: Task A
            depends:
              - foo

            # Body
        "}),
        bare_opts,
        Some("title".to_string()),
    );

    for key in graph.keys() {
        let title = graph.get_key_title(&key).unwrap_or_default();
        let meta = graph.get_metadata(&key);
        eprintln!("key={} title={:?} meta={:?}", key, title, meta);
    }

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "should find doc with depends=foo");
}
