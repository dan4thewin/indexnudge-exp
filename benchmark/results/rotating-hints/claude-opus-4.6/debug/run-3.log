use indoc::indoc;

use liwe::find::{DocumentFinder, FindOptions};
use liwe::graph::Graph;
use liwe::model::config::MarkdownOptions;
use liwe::state::from_indoc;

fn setup_graph(input: &str) -> Graph {
    Graph::import(&from_indoc(input), MarkdownOptions::default(), None)
}

#[test]
fn filters_by_single_string_value() {
    let graph = setup_graph(indoc! {"
        ---
        title: Task A
        status: ready
        ---

        # Task A
        _
        ---
        title: Task B
        status: done
        ---

        # Task B
    "});

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("status".to_string(), "ready".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1);
    assert_eq!(output.results[0].title, "Task A");
}

#[test]
fn combines_filters_with_and() {
    let graph = setup_graph(indoc! {"
        ---
        title: Note 1
        status: ready
        category: work
        ---

        # Note 1
        _
        ---
        title: Note 2
        status: ready
        category: personal
        ---

        # Note 2
    "});

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![
            ("status".to_string(), "ready".to_string()),
            ("category".to_string(), "work".to_string()),
        ],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1);
    assert_eq!(output.results[0].title, "Note 1");
}

#[test]
fn non_matching_value_excluded() {
    let graph = setup_graph(indoc! {"
        ---
        title: Task A
        status: done
        ---

        # Task A
    "});

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("status".to_string(), "ready".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 0);
}

#[test]
fn note_without_metadata_excluded() {
    let graph = setup_graph(indoc! {"
        # No Metadata
    "});

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("status".to_string(), "ready".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 0);
}

#[test]
fn value_in_yaml_sequence_matches() {
    let graph = setup_graph(indoc! {"
        ---
        title: Task A
        tags:
          - rust
          - iwe
        ---

        # Task A
    "});

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("tags".to_string(), "rust".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1);
    assert_eq!(output.results[0].title, "Task A");
}

#[test]
fn combines_with_roots_flag() {
    let graph = setup_graph(indoc! {"
        ---
        title: Root
        status: ready
        ---

        # Root

        [child](2)
        _
        ---
        title: Child
        status: ready
        ---

        # Child
    "});

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        roots: true,
        metadata_filters: vec![("status".to_string(), "ready".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1);
    assert_eq!(output.results[0].title, "Root");
}
