#[test]
fn bare_frontmatter_sequence_metadata_filter() {
    let bare_opts = MarkdownOptions {
        bare_frontmatter: true,
        ..Default::default()
    };
    let graph = Graph::import(
        &from_indoc(indoc! {"
            created: 2026-01-01
            title: Task A
            depends:
              - foo
              - bar

            # Body
        "}),
        bare_opts,
        Some("title".to_string()),
    );

    let finder = DocumentFinder::new(&graph);

    // Filter on a sequence value
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1);
    assert_eq!(output.results[0].title, "Task A");

    // Non-matching value
    let options2 = FindOptions {
        metadata_filters: vec![("depends".to_string(), "baz".to_string())],
        ..Default::default()
    };
    let output2 = finder.find(&options2);
    assert_eq!(output2.results.len(), 0);
}
EOF
