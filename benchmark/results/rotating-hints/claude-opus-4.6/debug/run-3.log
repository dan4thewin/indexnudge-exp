 231 │     fn get_section_path(&self, node_id: NodeId) -> Vec<String> {
 232 │         let mut path = Vec::new();
 233 │         let mut current = self.graph.node(node_id);
 234 │ 
 235 │         while let Some(parent) = current.to_parent() {
 236 │             if parent.is_section()
 237 │                 && parent
 238 │                     .to_parent()
 239 │                     .map(|p| p.is_document())
 240 │                     .unwrap_or(true)
 241 │             {
 242 │                 let text = parent.plain_text().trim().to_string();
 243 │                 path.push(text);
 244 │             }
 245 │             if parent.is_document() {
 246 │                 break;
 247 │             }
 248 │             current = parent;
 249 │         }
 250 │         path
