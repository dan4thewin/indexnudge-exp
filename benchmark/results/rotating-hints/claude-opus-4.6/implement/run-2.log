        result.push_str(&format!(" for \"{}\"", query));
    }
    if let Some(limit) = output.limit {
        result.push_str(&format!(" (showing {})", limit));
    }
    result.push_str(":\n\n");

    for r in &output.results {
        result.push_str(&format!("{}   #{}\n", r.display_title, r.key));
    }
