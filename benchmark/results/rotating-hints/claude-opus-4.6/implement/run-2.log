#[test]
fn test_find_count_flag() {
    let dir = setup_workspace();

    write(dir.path().join("doc1.md"), "# Doc One\n\nContent.").unwrap();
    write(dir.path().join("doc2.md"), "# Doc Two\n\nContent.").unwrap();
    write(dir.path().join("doc3.md"), "# Doc Three\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout.trim(), "3");
}

#[test]
fn test_find_count_with_query() {
    let dir = setup_workspace();

    write(dir.path().join("doc1.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("doc2.md"), "# Beta\n\nContent.").unwrap();
    write(dir.path().join("doc3.md"), "# Alpha Two\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count", "alpha"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout.trim(), "2");
}

#[test]
fn test_find_count_with_roots() {
    let dir = setup_workspace();

    write(
        dir.path().join("doc1.md"),
        "# Doc One\n\nContent.",
    )
    .unwrap();

    write(
        dir.path().join("doc2.md"),
        "# Doc Two\n\n![[doc1]]\n",
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count", "--roots"]);

    assert!(success, "stderr: {}", stderr);
    // doc2 is a root (nothing references it), doc1 is referenced by doc2
    assert_eq!(stdout.trim(), "1");
}
EOF

