 253 │     fn metadata_matches(&self, key: &Key, filters: &[(String, String)]) -> bool {
 254 │         let raw = match self.graph.get_metadata(key) {
 255 │             Some(s) => s,
 256 │             None => return false,
 257 │         };
 258 │         let val: serde_yaml::Value = match serde_yaml::from_str(raw) {
 259 │             Ok(v) => v,
 260 │             _ => return false,
 261 │         };
 262 │         filters.iter().all(|(k, v)| {
 263 │             val.get(k.as_str())
 264 │                 .and_then(|node| match node {
 265 │                     serde_yaml::Value::String(s) => Some(s.as_str() == v.as_str()),
 266 │                     serde_yaml::Value::Bool(b) => Some(b.to_string() == *v),
 267 │                     serde_yaml::Value::Number(n) => Some(n.to_string() == *v),
 268 │                     serde_yaml::Value::Sequence(items) => Some(
 269 │                         items
 270 │                             .iter()
 271 │                             .any(|i| i.as_str().map(|s| s == v.as_str()).unwrap_or(false)),
 272 │                     ),
 273 │                     _ => Some(false),
 274 │                 })
 275 │                 .unwrap_or(false)
 276 │         })
 277 │     }
 278 │ }
