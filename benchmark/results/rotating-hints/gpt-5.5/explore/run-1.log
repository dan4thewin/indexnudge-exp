  38 │     pub fn resolve(&self, graph: &Graph) -> HashSet<Key> {
  39 │         let mut candidates: Option<HashSet<Key>> = None;
  40 │ 
  41 │         for kd in &self.in_ {
  42 │             let depth = kd.depth.or(self.max_depth);
  43 │             let set = descendants_at_depth(graph, &kd.key, depth);
  44 │             candidates = Some(match candidates {
  45 │                 None => set,
  46 │                 Some(c) => c.intersection(&set).cloned().collect(),
  47 │             });
  48 │         }
  49 │ 
  50 │         if !self.in_any.is_empty() {
  51 │             let mut union: HashSet<Key> = HashSet::new();
  52 │             for kd in &self.in_any {
  53 │                 let depth = kd.depth.or(self.max_depth);
  54 │                 union.extend(descendants_at_depth(graph, &kd.key, depth));
  55 │             }
  56 │             candidates = Some(match candidates {
  57 │                 None => union,
  58 │                 Some(c) => c.intersection(&union).cloned().collect(),
  59 │             });
  60 │         }
  61 │ 
  62 │         let mut result =
  63 │             candidates.unwrap_or_else(|| graph.keys().into_iter().collect());
  64 │ 
  65 │         for kd in &self.not_in {
  66 │             let depth = kd.depth.or(self.max_depth);
  67 │             let exclude = descendants_at_depth(graph, &kd.key, depth);
  68 │             result = result.difference(&exclude).cloned().collect();
  69 │         }
  70 │ 
  71 │         result
  72 │     }
  73 │ }
