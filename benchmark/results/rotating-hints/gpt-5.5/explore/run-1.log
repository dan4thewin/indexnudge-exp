 880 │ fn build_tree_node(
 881 │     graph: &Graph,
 882 │     key: &Key,
 883 │     max_depth: u8,
 884 │     visited: &mut std::collections::HashSet<Key>,
 885 │ ) -> Option<TreeNode> {
 886 │     graph.get_node_id(key)?;
 887 │ 
 888 │     let title = graph.get_ref_text(key).unwrap_or_default();
 889 │     let key_str = key.to_string();
 890 │ 
 891 │     if visited.contains(key) {
 892 │         return Some(TreeNode {
 893 │             key: key_str,
 894 │             title,
 895 │             children: vec![],
 896 │         });
 897 │     }
 898 │     visited.insert(key.clone());
 899 │ 
 900 │     let children = if max_depth > 1 {
 901 │         let ref_node_ids = graph.get_block_references_in(key);
 902 │         ref_node_ids
 903 │             .iter()
 904 │             .filter_map(|id| graph.graph_node(*id).ref_key())
 905 │             .sorted()
 906 │             .filter_map(|ref_key| build_tree_node(graph, &ref_key, max_depth - 1, visited))
 907 │             .collect()
 908 │     } else {
 909 │         vec![]
 910 │     };
 911 │ 
 912 │     Some(TreeNode {
 913 │         key: key_str,
 914 │         title,
 915 │         children,
 916 │     })
 917 │ }
