  ── descendants_at_depth (L75-L109) ──
  75 │ pub fn descendants_at_depth(graph: &Graph, origin: &Key, depth: Option<u8>) -> HashSet<Key> {
  76 │     let mut result: HashSet<Key> = HashSet::new();
  77 │     let mut frontier: Vec<Key> = vec![origin.clone()];
  78 │     let mut walked: u8 = 0;
  79 │ 
  80 │     loop {
  81 │         if let Some(d) = depth {
  82 │             if walked >= d {
  83 │                 break;
  84 │             }
  85 │         }
  86 │ 
  87 │         let mut next: Vec<Key> = Vec::new();
  88 │         for current in &frontier {
  89 │             for ref_id in graph.get_block_references_in(current) {
  90 │                 if let Some(ref_key) = graph.graph_node(ref_id).ref_key() {
  91 │                     if &ref_key == origin {
  92 │                         continue;
  93 │                     }
  94 │                     if result.insert(ref_key.clone()) {
  95 │                         next.push(ref_key);
  96 │                     }
  97 │                 }
  98 │             }
  99 │         }
 100 │ 
 101 │         if next.is_empty() {
 102 │             break;
 103 │         }
 104 │         frontier = next;
 105 │         walked = walked.saturating_add(1);
 106 │     }
 107 │ 
 108 │     result
 109 │ }
