112|    #[schemars(description = "Maximum number of results to return")]
113|    pub limit: Option<usize>,
114|    #[schemars(description = "Filter by front matter metadata (list of key=value strings)")]
115|    #[serde(default)]
116|    pub meta: Option<Vec<(String, String)>>,
117|    #[serde(flatten)]
118|    pub selector: SelectorParams,
119|}
