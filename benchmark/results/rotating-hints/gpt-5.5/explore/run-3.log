124|            query: p.query,
125|            roots: p.roots.unwrap_or(false),
126|            refs_to: p.refs_to.map(|k| Key::name(&k)),
127|            refs_from: p.refs_from.map(|k| Key::name(&k)),
128|            selector: p.selector.into(),
129|            limit: p.limit,
130|            metadata_filters: p.meta.unwrap_or_default(),
131|        }
132|    }
