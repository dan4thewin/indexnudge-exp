$a

#[test]
fn test_find_count_lists_only_match_count() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nContent.").unwrap();
    write(dir.path().join("gamma.md"), "# Gamma\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "3\n");
}

#[test]
fn test_find_count_uses_total_before_limit() {
    let dir = setup_workspace();

    for i in 1..=10 {
        write(
            dir.path().join(format!("doc{}.md", i)),
            format!("# Document {}\n\nContent.", i),
        )
        .unwrap();
    }

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count", "--limit", "3"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "10\n");
}

#[test]
fn test_find_count_combines_with_roots_refs_and_metadata_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join("parent.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Parent

            [child](child)
        "},
    )
    .unwrap();
    write(
        dir.path().join("child.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Child
        "},
    )
    .unwrap();
    write(
        dir.path().join("other.md"),
        indoc! {"
            ---
            status: done
            ---

            # Other
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &["--count", "--roots", "--refs-to", "child", "--meta", "status=ready"],
    );

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "1\n");
}
