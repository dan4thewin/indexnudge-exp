+            ---
+
+            # Parent
+
+            [child](child)
+        "},
+    )
+    .unwrap();
+    write(
+        dir.path().join("child.md"),
+        indoc! {"
+            ---
+            status: ready
+            ---
+
+            # Child
+        "},
+    )
+    .unwrap();
+    write(
+        dir.path().join("other.md"),
+        indoc! {"
+            ---
+            status: done
+            ---
+
+            # Other
+        "},
