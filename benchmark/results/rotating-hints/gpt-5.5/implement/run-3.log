#[test]
fn test_find_count_lists_only_matching_document_count() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nContent.").unwrap();
    write(dir.path().join("gamma.md"), "# Gamma\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "3\n");
}

#[test]
fn test_find_count_respects_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join("root.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Root

            [target](target)

            [child](child)
        "},
    )
    .unwrap();

    write(
        dir.path().join("child.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Child

            [target](target)
        "},
    )
    .unwrap();

    write(
        dir.path().join("other.md"),
        indoc! {"
            ---
            status: done
            ---

            # Other

            [target](target)
        "},
    )
    .unwrap();

    write(dir.path().join("target.md"), "# Target\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &[
            "--count",
            "--refs-to",
            "target",
            "--in",
            "root",
            "--meta",
            "status=ready",
        ],
    );

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "1\n");
}
.
