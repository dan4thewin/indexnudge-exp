#[test]
fn test_find_count_with_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join("parent.md"),
        indoc! {"
            ---
            status: ready
            ---
            # Parent

            [child](child)
        "},
    )
    .unwrap();
    write(
        dir.path().join("child.md"),
        indoc! {"
