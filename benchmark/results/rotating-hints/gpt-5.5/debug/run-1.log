  55 │     pub fn find(&self, options: &FindOptions) -> FindOutput {
  56 │         let matcher = SkimMatcherV2::default();
  57 │ 
  58 │         let candidate_set = if options.selector.is_empty() {
  59 │             None
  60 │         } else {
  61 │             Some(options.selector.resolve(self.graph))
  62 │         };
  63 │ 
  64 │         let mut results: Vec<(Key, i64)> = self
  65 │             .graph
  66 │             .keys()
  67 │             .into_iter()
  68 │             .filter_map(|key| {
  69 │                 if let Some(set) = &candidate_set {
  70 │                     if !set.contains(&key) {
  71 │                         return None;
  72 │                     }
  73 │                 }
  74 │                 if options.roots && !self.is_root(&key) {
  75 │                     return None;
  76 │                 }
  77 │                 if let Some(ref target) = options.refs_to {
  78 │                     if !self.references(&key, target) {
  79 │                         return None;
  80 │                     }
  81 │                 }
  82 │                 if let Some(ref source) = options.refs_from {
  83 │                     if !self.references(source, &key) {
  84 │                         return None;
  85 │                     }
  86 │                 }
  87 │ 
  88 │                 if !options.metadata_filters.is_empty()
  89 │                     && !self.metadata_matches(&key, &options.metadata_filters)
  90 │                 {
  91 │                     return None;
  92 │                 }
  93 │ 
  94 │                 let title = self.graph.get_key_title(&key).unwrap_or_default();
  95 │                 let search_text = format!("{} {}", key, title);
  96 │ 
  97 │                 let score = options
  98 │                     .query
  99 │                     .as_ref()
 100 │                     .map(|q| matcher.fuzzy_match(&search_text, q).unwrap_or(0))
 101 │                     .unwrap_or(self.node_rank(&key) as i64);
 102 │ 
 103 │                 if options.query.is_some() && score == 0 {
 104 │                     return None;
 105 │                 }
 106 │ 
 107 │                 Some((key, score))
 108 │             })
 109 │             .collect();
 110 │ 
 111 │         results.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
 112 │ 
 113 │         let total = results.len();
 114 │         let results: Vec<FindResult> = if let Some(limit) = options.limit {
 115 │             results
 116 │                 .into_iter()
 117 │                 .take(limit)
 118 │                 .map(|(key, _)| self.build_result(&key))
 119 │                 .collect()
 120 │         } else {
 121 │             results
 122 │                 .into_iter()
 123 │                 .map(|(key, _)| self.build_result(&key))
 124 │                 .collect()
 125 │         };
 126 │ 
 127 │         let limit = options.limit.filter(|&l| l < total);
 128 │ 
 129 │         FindOutput {
 130 │             query: options.query.clone(),
 131 │             limit,
 132 │             total,
 133 │             results,
 134 │         }
 135 │     }
