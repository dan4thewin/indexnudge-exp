use std::sync::Once;

use indoc::indoc;
use pretty_assertions::assert_str_eq;

use liwe::model::config::MarkdownOptions;
use liwe::{
    graph::Graph,
    state::{from_indoc, to_indoc},
};

static INIT: Once = Once::new();

fn setup() {
    INIT.call_once(|| {
        env_logger::builder().init();
    });
}

fn bare_options() -> MarkdownOptions {
    MarkdownOptions {
        bare_frontmatter: true,
        ..Default::default()
    }
}

#[test]
fn reader_detects_bare_title_block() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: Foo
            status: ready

            # Body
            "}),
        bare_options(),
        None,
    );

    let state = graph.export();
    let content = state.values().next().unwrap();
    // The metadata should have been parsed — the output should have fenced front matter
    // since we're exporting with bare_frontmatter=true, it should be bare again
    assert!(content.starts_with("title: Foo"));
}

#[test]
fn reader_skips_when_disabled() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: Foo
            status: ready

            # Body
            "}),
        MarkdownOptions::default(), // bare_frontmatter = false
        None,
    );

    let state = graph.export();
    let content = state.values().next().unwrap();
    // Without bare_frontmatter, "title: Foo" is just body text, no metadata parsed
    // So no frontmatter block in output
    assert!(!content.contains("---"));
}

#[test]
fn reader_skips_when_no_title_first_line() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            date: 2024-01-01
            title: Foo

            # Body
            "}),
        bare_options(),
        None,
    );

    let state = graph.export();
    let content = state.values().next().unwrap();
    // First line isn't "title: " so no metadata parsed
    assert!(!content.contains("---"));
}

#[test]
fn reader_does_not_misparse_prose() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            This is a paragraph.

            # H
            "}),
        bare_options(),
        None,
    );

    let state = graph.export();
    let content = state.values().next().unwrap();
    assert!(!content.contains("---"));
}

#[test]
fn reader_still_handles_fenced() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            ---
            title: Fenced
            ---

            # Header
            "}),
        bare_options(),
        None,
    );

    let state = graph.export();
    let content = state.values().next().unwrap();
    // With bare_frontmatter enabled, writer should emit bare format
    assert!(content.starts_with("title: Fenced"));
    assert!(!content.starts_with("---"));
}

#[test]
fn writer_emits_bare_when_enabled() {
    setup();

    let input = indoc! {"
        title: Foo

        # Body
    "};

    let graph = Graph::import(
        &from_indoc(input),
        bare_options(),
        None,
    );

    let state = graph.export();
    let content = state.values().next().unwrap();
    assert!(content.starts_with("title: Foo"));
    assert!(!content.starts_with("---"));
    assert!(content.contains("# Body"));
}

#[test]
fn writer_emits_fenced_when_disabled() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            ---
            title: Foo
            ---

            # Body
            "}),
        MarkdownOptions::default(),
        None,
    );

    let state = graph.export();
    let content = state.values().next().unwrap();
    assert!(content.starts_with("---\ntitle: Foo\n---"));
}

#[test]
fn frontmatter_title_works_with_bare() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            [old](2)
            _
            title: Bare Title
            status: ready

            # Header
            "}),
        bare_options(),
        Some("title".to_string()),
    );

    let normalized = to_indoc(&graph.export());

    assert_str_eq!(
        indoc! {"
            [Bare Title](2)
            _
            title: Bare Title
            status: ready

            # Header
            "},
        normalized
    );
}

