use indoc::indoc;
use liwe::find::{DocumentFinder, FindOptions};
use liwe::graph::Graph;
use liwe::model::config::MarkdownOptions;
use liwe::state::from_indoc;

fn bare_options() -> MarkdownOptions {
    MarkdownOptions {
        bare_frontmatter: true,
        ..Default::default()
    }
}

#[test]
fn bare_frontmatter_sequence_meta_filter() {
    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: Task A
            depends:
              - foo
              - bar

            # Task A
        "}),
        bare_options(),
        None,
    );

    // Debug: print metadata
    for key in graph.keys() {
        eprintln!("key={} metadata={:?}", key, graph.get_metadata(&key));
    }

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "should find doc with depends: foo");
}

#[test]
fn fenced_frontmatter_sequence_meta_filter() {
    let graph = Graph::import(
        &from_indoc(indoc! {"
            ---
            title: Task A
            depends:
              - foo
              - bar
            ---

            # Task A
        "}),
        MarkdownOptions::default(),
        None,
    );

    for key in graph.keys() {
        eprintln!("key={} metadata={:?}", key, graph.get_metadata(&key));
    }

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "should find doc with depends: foo");
}
