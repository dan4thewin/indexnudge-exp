    let content = "title: Test\ndepends:\n  - foo\n  - bar\nstatus: ready\n\n# Body\n";
    
    // wrap_bare_frontmatter logic from HEAD
    if content.starts_with("---") { panic!(); }
    if !content.starts_with("title: ") { panic!(); }
    
