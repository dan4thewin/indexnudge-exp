#[test]
fn metadata_matches_list_values_in_bare_frontmatter() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: Foo
            depends:
              - bar
              - baz

            # Body
            "}),
        bare_options(),
        None,
    );

    // Verify the metadata was parsed and contains the list
    let key = graph.keys().into_iter().next().unwrap();
    let meta = graph.get_metadata(&key).expect("should have metadata");
    let val: serde_yaml::Value = serde_yaml::from_str(meta).unwrap();
    let deps = val.get("depends").expect("should have depends field");
    assert!(deps.is_sequence(), "depends should be a sequence");
    let items: Vec<&str> = deps
        .as_sequence()
        .unwrap()
        .iter()
        .map(|v| v.as_str().unwrap())
        .collect();
    assert_eq!(items, vec!["bar", "baz"]);
}
TESTEOF

