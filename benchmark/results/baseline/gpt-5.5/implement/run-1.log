#[test]
fn test_find_count_lists_matching_document_count() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}

#[test]
fn test_find_count_respects_existing_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join("parent.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Parent

            [target](target)
            [child](child)
        "},
    )
    .unwrap();
    write(
        dir.path().join("other.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Other

            [target](target)
        "},
    )
    .unwrap();
    write(
        dir.path().join("draft.md"),
        indoc! {"
            ---
            status: draft
            ---

            # Draft

            [target](target)
        "},
    )
    .unwrap();
    write(dir.path().join("child.md"), "# Child\n\nContent.").unwrap();
    write(dir.path().join("target.md"), "# Target\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &["--count", "--roots", "--refs-to", "target", "--meta", "status=ready"],
    );

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}

#[test]
fn test_find_count_ignores_limit_and_format() {
    let dir = setup_workspace();

    for i in 1..=5 {
        write(
            dir.path().join(format!("doc{}.md", i)),
            format!("# Document {}\n\nContent.", i),
        )
        .unwrap();
    }

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count", "--limit", "2", "-f", "json"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "5\n");
}
