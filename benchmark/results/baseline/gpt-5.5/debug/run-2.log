67|impl GraphBlock {
68|    fn is_sparce_list(&self) -> bool {
69|        match self {
70|            GraphBlock::BulletList(items) => items
71|                .iter()
72|                .any(|item| item.iter().filter(|block| block.is_paragraph()).count() > 1),
73|            GraphBlock::OrderedList(items) => items
74|                .iter()
75|                .any(|item| item.iter().filter(|block| block.is_paragraph()).count() > 1),
76|            _ => false,
77|        }
78|    }
79|
80|    fn is_list(&self) -> bool {
81|        matches!(self, GraphBlock::BulletList(_) | GraphBlock::OrderedList(_))
82|    }
83|
84|    fn is_paragraph(&self) -> bool {
85|        matches!(self, GraphBlock::Plain(_) | GraphBlock::Para(_))
86|    }
87|
88|    fn is_frontmatter(&self) -> bool {
89|        matches!(self, GraphBlock::Frontmatter(_))
90|    }
91|
92|    pub fn to_markdown(&self, options: &MarkdownOptions) -> String {
93|        match self {
94|            GraphBlock::Frontmatter(content) => {
95|                if options.bare_frontmatter {
96|                    format!("{}\n", content.trim_end())
97|                } else {
98|                    format!("---\n{}---\n", content)
99|                }
100|            }
101|            GraphBlock::Plain(inlines) => format!("{}\n", inlines_to_markdown(inlines, options)),
102|            GraphBlock::Para(inlines) => format!("{}\n", inlines_to_markdown(inlines, options)),
103|            GraphBlock::LineBlock(lines) => lines
104|                .iter()
105|                .map(|line| inlines_to_markdown(line, options))
106|                .collect::<Vec<String>>()
107|                .join("\n"),
108|            GraphBlock::CodeBlock(lang, text) => {
109|                let fence = options
110|                    .formatting
111|                    .code_block_token()
112|                    .repeat(options.formatting.code_block_token_count());
113|                lang.clone()
114|                    .filter(|lang| !lang.trim().is_empty())
115|                    .map(|lang| {
116|                        format!("{} {}\n{}\n{}\n", fence, lang, text.trim_matches('\n'), fence)
117|                    })
118|                    .unwrap_or_else(|| {
119|                        format!("{}\n{}\n{}\n", fence, text.trim_matches('\n'), fence)
120|                    })
121|            }
122|            GraphBlock::RawBlock(_, text) => text.clone(),
123|            GraphBlock::BlockQuote(blocks) => {
124|                blocks_to_markdown_sparce(blocks, options)
125|                    .lines()
126|                    .map(|line| format!("> {}", line))
127|                    .map(|line| line.trim().to_string())
128|                    .collect::<Vec<String>>()
129|                    .join("\n")
130|                    + "\n"
131|            }
132|            GraphBlock::OrderedList(items) => items
133|                .iter()
134|                .enumerate()
135|                .map(|(n, item)| {
136|                    let num = if options.formatting.increment_ordered_list_bullets() {
137|                        n + 1
138|                    } else {
139|                        1
140|                    };
141|                    left_pad_and_prefix_num(
142|                        &blocks_to_markdown_and(item, self.is_sparce_list(), options),
143|                        num,
144|                        options.formatting.ordered_list_token_char(),
145|                    )
146|                })
147|                .collect::<Vec<String>>()
148|                .join(if self.is_sparce_list() { "\n" } else { "" }),
149|            GraphBlock::BulletList(items) => items
150|                .iter()
