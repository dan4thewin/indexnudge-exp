324|
325|fn pad_cell(content: &str, width: usize, alignment: Option<ColumnAlignment>) -> String {
326|    let content_len = content.chars().count();
327|    if content_len >= width {
328|        return content.to_string();
329|    }
330|    let padding = width - content_len;
331|    match alignment.unwrap_or(ColumnAlignment::None) {
332|        ColumnAlignment::Right => format!("{}{}", " ".repeat(padding), content),
333|        ColumnAlignment::Center => {
334|            let left = padding / 2;
335|            let right = padding - left;
336|            format!("{}{}{}", " ".repeat(left), content, " ".repeat(right))
337|        }
338|        _ => format!("{}{}", content, " ".repeat(padding)),
339|    }
340|}
341|
342|fn separator_cell(width: usize, alignment: ColumnAlignment) -> String {
343|    match alignment {
344|        ColumnAlignment::Left => format!(":{}", "-".repeat(width + 1)),
345|        ColumnAlignment::Right => format!("{}:", "-".repeat(width + 1)),
346|        ColumnAlignment::Center => format!(":{}:", "-".repeat(width)),
347|        ColumnAlignment::None => format!(" {} ", "-".repeat(width)),
348|    }
349|}
