351|fn link_type(link_type: document::LinkType) -> pulldown_cmark::LinkType {
352|    match link_type {
353|        document::LinkType::Markdown => pulldown_cmark::LinkType::Inline,
354|        document::LinkType::WikiLink => pulldown_cmark::LinkType::WikiLink { has_pothole: false },
355|        document::LinkType::WikiLinkPiped => {
356|            pulldown_cmark::LinkType::WikiLink { has_pothole: true }
357|        }
358|    }
359|}
