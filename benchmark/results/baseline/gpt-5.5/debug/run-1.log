254|    fn render_aligned_table(
255|        &self,
256|        header: &[GraphInlines],
257|        alignment: &[ColumnAlignment],
258|        rows: &[Vec<GraphInlines>],
259|    ) -> String {
260|        let header_strs: Vec<String> = header
261|            .iter()
262|            .map(|c| inlines_to_markdown(c, &self.options))
263|            .collect();
264|        let row_strs: Vec<Vec<String>> = rows
265|            .iter()
266|            .map(|row| {
267|                row.iter()
268|                    .map(|c| inlines_to_markdown(c, &self.options))
269|                    .collect()
270|            })
271|            .collect();
272|
273|        let num_cols = header.len();
274|        let mut widths: Vec<usize> = header_strs.iter().map(|s| s.chars().count()).collect();
275|
276|        for row in &row_strs {
277|            for (i, cell) in row.iter().enumerate() {
278|                if i < widths.len() {
279|                    widths[i] = widths[i].max(cell.chars().count());
280|                }
281|            }
282|        }
283|
284|        for w in &mut widths {
285|            if *w < 3 {
286|                *w = 3;
287|            }
288|        }
289|
290|        let mut result = String::new();
291|
292|        result.push('|');
293|        for (i, cell) in header_strs.iter().enumerate() {
294|            let width = widths.get(i).copied().unwrap_or(3);
295|            result.push(' ');
296|            result.push_str(&pad_cell(cell, width, alignment.get(i).copied()));
297|            result.push_str(" |");
298|        }
299|        result.push('\n');
300|
301|        result.push('|');
302|        for (i, &width) in widths.iter().enumerate() {
303|            let al = alignment.get(i).copied().unwrap_or(ColumnAlignment::None);
304|            result.push_str(&separator_cell(width, al));
305|            result.push('|');
306|        }
307|        result.push('\n');
308|
309|        for row in &row_strs {
310|            result.push('|');
311|            for i in 0..num_cols {
312|                let cell = row.get(i).map(|s| s.as_str()).unwrap_or("");
313|                let width = widths.get(i).copied().unwrap_or(3);
314|                result.push(' ');
315|                result.push_str(&pad_cell(cell, width, alignment.get(i).copied()));
316|                result.push_str(" |");
317|            }
318|            result.push('\n');
319|        }
320|
321|        result
322|    }
