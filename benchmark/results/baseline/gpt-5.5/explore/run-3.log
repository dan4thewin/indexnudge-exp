1036:fn get_library_path(configuration: &Configuration) -> PathBuf {
1037:    let current_dir = env::current_dir().expect("to get current dir");
1038:
1039:    let mut library_path = current_dir;
1040:
1041:    if !configuration.library.path.is_empty() {
1042:        library_path.push(configuration.library.path.clone());
1043:    }
1044:
1045:    library_path
1046:}
