715:fn init_command(init: Init) {
716:    info!("initializing IWE");
717:    let mut path = env::current_dir().expect("to get current dir");
718:    path.push(IWE_MARKER);
719:    if path.is_dir() {
720:        error!("IWE is already initialized in the current location.");
721:        return;
722:    }
723:    if path.exists() {
724:        error!("Initialization failed: '.iwe' path already exists in the current location.");
725:        return;
726:    }
727:    create_dir(&path).expect("to create .iwe directory");
728:
729:    let toml = toml::to_string(&Configuration::template()).expect("valid TOML");
730:
731:    std::fs::write(path.join(CONFIG_FILE_NAME), toml).expect("Failed to write to config.json");
732:    info!("IWE initialized in the current location. Default config added to .iwe/config.json");
733:}
