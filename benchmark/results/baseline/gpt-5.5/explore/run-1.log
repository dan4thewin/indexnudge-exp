35|#[derive(Debug, Clone, Default)]
36|pub struct FindOptions {
37|    pub query: Option<String>,
38|    pub roots: bool,
39|    pub refs_to: Option<Key>,
40|    pub refs_from: Option<Key>,
41|    pub selector: Selector,
42|    pub limit: Option<usize>,
43|    pub metadata_filters: Vec<(String, String)>,
44|}
45|
47|    graph: &'a Graph,
48|}
