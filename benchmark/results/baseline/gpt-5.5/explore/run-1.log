83|/// Scan `base_path` for directories that transitively contain `.md` files
84|/// and generate/maintain `_dirname.md` index files.
85|fn generate_virtual_indices(base_path: &Path) {
86|    use std::collections::{BTreeSet, HashSet};
87|
88|    // Collect all directories that transitively contain .md files.
89|    let mut dirs_with_md: HashSet<PathBuf> = HashSet::new();
90|
91|    for entry in WalkBuilder::new(base_path)
92|        .follow_links(false)
93|        .hidden(true)
94|        .require_git(false)
95|        .build()
96|        .flatten()
97|    {
98|        let path = entry.path();
99|        if path.is_file() && path.extension().is_some_and(|ext| ext == "md") {
100|            // Walk up from parent to base, marking each as containing .md
101|            let mut dir = path.parent();
102|            while let Some(d) = dir {
103|                if d == base_path {
104|                    break;
105|                }
106|                if !dirs_with_md.insert(d.to_path_buf()) {
107|                    break; // already visited
108|                }
109|                dir = d.parent();
110|            }
111|        }
112|    }
113|
114|    // For each directory with .md files, generate or maintain index.
115|    for dir in &dirs_with_md {
116|        let dir_name = match dir.file_name() {
117|            Some(n) => n.to_string_lossy().to_string(),
118|            None => continue,
119|        };
120|
121|        let parent = match dir.parent() {
122|            Some(p) => p,
123|            None => continue,
124|        };
125|
126|        let user_index = parent.join(format!("{}.md", dir_name));
127|        let generated_index = parent.join(format!("_{}.md", dir_name));
128|
129|        // If user index exists, delete generated if present, skip.
130|        if user_index.exists() {
131|            if generated_index.exists() {
132|                let _ = fs::remove_file(&generated_index);
133|            }
134|            continue;
135|        }
136|
137|        // Collect children: .md files directly in dir (excluding _*.md generated indices)
138|        // and subdirectories that are in dirs_with_md.
139|        let mut children_keys: BTreeSet<String> = BTreeSet::new();
140|
141|        let relative_dir = dir.strip_prefix(base_path).unwrap_or(Path::new(""));
142|
143|        // Direct .md files in this directory
144|        if let Ok(entries) = fs::read_dir(dir) {
145|            for entry in entries.flatten() {
146|                let p = entry.path();
147|                if p.is_file() && p.extension().is_some_and(|ext| ext == "md") {
148|                    let fname = p
149|                        .file_name()
150|                        .map(|n| n.to_string_lossy().to_string())
151|                        .unwrap_or_default();
152|                    // Skip generated index files
153|                    if fname.starts_with('_') {
154|                        continue;
155|                    }
156|                    let key_name = fname.trim_end_matches(".md");
157|                    let child_key = format!(
158|                        "{}/{}",
159|                        relative_dir.to_string_lossy(),
160|                        key_name
161|                    );
162|                    children_keys.insert(child_key);
163|                } else if p.is_dir() && dirs_with_md.contains(&p) {
164|                    let subdir_name = p
165|                        .file_name()
166|                        .map(|n| n.to_string_lossy().to_string())
167|                        .unwrap_or_default();
168|                    let child_key = format!(
169|                        "{}/{}",
170|                        relative_dir.to_string_lossy(),
171|                        subdir_name
172|                    );
173|                    children_keys.insert(child_key);
174|                }
175|            }
176|        }
177|
178|        if children_keys.is_empty() {
179|            continue;
180|        }
181|
182|        // Generate content
183|        let mut content = format!("# {}\n", dir_name);
184|        for child_key in &children_keys {
185|            let link_text = child_key.rsplit('/').next().unwrap_or(child_key);
186|            content.push_str(&format!("\n[{}]({})\n", link_text, child_key));
187|        }
188|
189|        // Check if regeneration needed
190|        if generated_index.exists() {
191|            if let Ok(existing) = fs::read_to_string(&generated_index) {
192|                if existing == content {
193|                    continue; // up to date
194|                }
195|            }
196|        }
197|
198|        let _ = fs::write(&generated_index, &content);
199|    }
200|}
