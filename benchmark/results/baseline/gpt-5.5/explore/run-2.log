17|pub fn new_for_path_with_options(base_path: &PathBuf, virtual_directories: bool) -> State {
18|    if !base_path.exists() {
19|        error!("path doesn't exist");
20|        return State::new();
21|    }
22|
23|    if virtual_directories {
24|        generate_virtual_indices(base_path);
25|    }
26|
27|    let strip_underscore = virtual_directories;
28|
29|    WalkBuilder::new(base_path)
30|        .follow_links(false)
31|        .hidden(true)
32|        .require_git(false)
33|        .build()
34|        .filter_map(|entry| {
35|            let entry = entry.ok()?;
36|            let path = entry.path();
37|
38|            if !path.is_file() || path.extension().is_none_or(|ext| ext != "md") {
39|                return None;
40|            }
41|
42|            let relative_path = path.strip_prefix(base_path).ok()?;
43|            let key = if let Some(parent) = relative_path.parent() {
44|                if parent == std::path::Path::new("") {
45|                    to_file_name(path, strip_underscore)
46|                } else {
47|                    format!("{}/{}", parent.to_string_lossy(), to_file_name(path, strip_underscore))
48|                }
49|            } else {
50|                to_file_name(path, strip_underscore)
51|            };
52|
53|            fs::read_to_string(path).ok().map(|content| (key, content))
54|        })
55|        .collect()
