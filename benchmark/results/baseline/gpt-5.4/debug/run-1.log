new = '''/// If `bare_frontmatter` is enabled and content starts with `title: ` (but
/// not `---`), wrap the leading frontmatter block in `---` fences so the
/// downstream pulldown-cmark MetadataBlock machinery picks it up.
pub fn wrap_bare_frontmatter(content: &str) -> Cow<'_, str> {
    if content.starts_with("---") {
        return Cow::Borrowed(content);
    }

    if !content.starts_with("title: ") {
        return Cow::Borrowed(content);
    }

    let (header, rest, separator) = if let Some(pos) = content.find("\r\n\r\n") {
        (&content[..pos], &content[pos + 4..], "\r\n\r\n")
    } else if let Some(pos) = content.find("\n\n") {
        (&content[..pos], &content[pos + 2..], "\n\n")
    } else {
        (content.trim_end_matches(['\r', '\n']), "", "\n\n")
    };

    if !header.lines().all(|line| {
        line.is_empty() || line.starts_with(' ') || line.contains(':')
    }) {
        return Cow::Borrowed(content);
    }

    let mut wrapped = String::new();
    wrapped.push_str("---\n");
    wrapped.push_str(header);
    if !header.ends_with('\n') && !header.ends_with("\r\n") {
        wrapped.push('\n');
    }
    wrapped.push_str("---");

    if rest.is_empty() {
        wrapped.push('\n');
    } else {
        wrapped.push_str(separator);
        wrapped.push_str(rest);
    }

    Cow::Owned(wrapped)
}
