57|impl Reader for MarkdownReader {
58|    fn document(&self, content: &str, markdown_options: &MarkdownOptions) -> Document {
59|        let effective = if markdown_options.bare_frontmatter {
60|            wrap_bare_frontmatter(content)
61|        } else {
62|            Cow::Borrowed(content)
63|        };
64|
65|        let mut reader = MarkdownEventsReader::new_with_options(markdown_options);
66|        reader.read(&effective);
67|
68|        Document {
69|            blocks: reader.blocks(),
70|            metadata: reader.metadata(),
71|        }
72|    }
