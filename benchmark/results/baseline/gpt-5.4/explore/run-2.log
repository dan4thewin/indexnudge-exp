45|
46|pub struct DocumentFinder<'a> {
47|    graph: &'a Graph,
48|}
49|
50|impl<'a> DocumentFinder<'a> {
51|    pub fn new(graph: &'a Graph) -> Self {
52|        Self { graph }
53|    }
54|
55|    pub fn find(&self, options: &FindOptions) -> FindOutput {
56|        let matcher = SkimMatcherV2::default();
57|
58|        let candidate_set = if options.selector.is_empty() {
59|            None
60|        } else {
61|            Some(options.selector.resolve(self.graph))
62|        };
63|
64|        let mut results: Vec<(Key, i64)> = self
65|            .graph
66|            .keys()
67|            .into_iter()
68|            .filter_map(|key| {
69|                if let Some(set) = &candidate_set {
70|                    if !set.contains(&key) {
71|                        return None;
72|                    }
73|                }
74|                if options.roots && !self.is_root(&key) {
75|                    return None;
76|                }
77|                if let Some(ref target) = options.refs_to {
78|                    if !self.references(&key, target) {
79|                        return None;
80|                    }
81|                }
82|                if let Some(ref source) = options.refs_from {
83|                    if !self.references(source, &key) {
84|                        return None;
85|                    }
86|                }
87|
88|                if !options.metadata_filters.is_empty()
89|                    && !self.metadata_matches(&key, &options.metadata_filters)
90|                {
91|                    return None;
92|                }
93|
94|                let title = self.graph.get_key_title(&key).unwrap_or_default();
95|                let search_text = format!("{} {}", key, title);
96|
97|                let score = options
98|                    .query
99|                    .as_ref()
100|                    .map(|q| matcher.fuzzy_match(&search_text, q).unwrap_or(0))
101|                    .unwrap_or(self.node_rank(&key) as i64);
102|
103|                if options.query.is_some() && score == 0 {
104|                    return None;
105|                }
106|
107|                Some((key, score))
108|            })
109|            .collect();
110|
111|        results.sort_by(|a, b| b.1.cmp(&a.1).then_with(|| a.0.cmp(&b.0)));
112|
113|        let total = results.len();
114|        let results: Vec<FindResult> = if let Some(limit) = options.limit {
115|            results
116|                .into_iter()
117|                .take(limit)
118|                .map(|(key, _)| self.build_result(&key))
119|                .collect()
120|        } else {
121|            results
122|                .into_iter()
123|                .map(|(key, _)| self.build_result(&key))
124|                .collect()
125|        };
126|
127|        let limit = options.limit.filter(|&l| l < total);
128|
129|        FindOutput {
130|            query: options.query.clone(),
131|            limit,
132|            total,
133|            results,
134|        }
135|    }
136|
137|    fn build_result(&self, key: &Key) -> FindResult {
138|        let title = self.graph.get_key_title(key).unwrap_or_default();
139|        let parent_documents = self.get_parent_documents(key);
140|        let display_title = Self::render_display_title(&title, &parent_documents);
141|
142|        FindResult {
143|            key: key.to_string(),
144|            title,
145|            display_title,
146|            is_root: self.is_root(key),
147|            incoming_refs: self.graph.get_block_references_to(key).len()
148|                + self.graph.get_inline_references_to(key).len(),
149|            outgoing_refs: self.graph.get_block_references_in(key).len(),
150|            parent_documents,
151|        }
152|    }
153|
154|    fn render_display_title(title: &str, parent_documents: &[ParentDocumentInfo]) -> String {
155|        if parent_documents.is_empty() {
156|            title.to_string()
157|        } else {
158|            let parents = parent_documents
159|                .iter()
160|                .map(|p| format!("↖{}", p.title))
161|                .collect::<Vec<_>>()
162|                .join(" ");
163|            format!("{} {}", title, parents)
164|        }
165|    }
166|
167|    fn is_root(&self, key: &Key) -> bool {
168|        self.graph.get_block_references_to(key).is_empty()
169|    }
170|
171|    fn node_rank(&self, key: &Key) -> usize {
172|        self.graph.get_inline_references_to(key).len()
173|            + self.graph.get_block_references_to(key).len()
174|    }
175|
176|    fn references(&self, source: &Key, target: &Key) -> bool {
177|        let block_refs = self.graph.get_block_references_in(source);
178|        for ref_id in block_refs {
179|            if let Some(ref_key) = self.graph.graph_node(ref_id).ref_key() {
180|                if &ref_key == target {
181|                    return true;
182|                }
183|            }
184|        }
185|
186|        if let Some(node_id) = self.graph.get_node_id(source) {
187|            let sub_nodes = self.graph.node(node_id).get_all_sub_nodes();
188|            for sub_node_id in sub_nodes {
189|                if let Some(line_id) = self.graph.graph_node(sub_node_id).line_id() {
190|                    let line = self.graph.get_line(line_id);
191|                    for ref_key in line.ref_keys() {
192|                        if &ref_key == target {
193|                            return true;
194|                        }
195|                    }
196|                }
197|            }
198|        }
199|
200|        false
201|    }
202|
203|    fn get_parent_documents(&self, key: &Key) -> Vec<ParentDocumentInfo> {
204|        let refs = self.graph.get_block_references_to(key);
205|        let mut parents = Vec::new();
206|
207|        for ref_id in refs {
208|            let node = self.graph.node(ref_id);
209|
210|            if let Some(doc_node) = node.to_document() {
211|                if let Some(doc_key) = doc_node.document_key() {
212|                    let title = self
213|                        .graph
214|                        .get_key_title(&doc_key)
215|                        .unwrap_or_else(|| doc_key.to_string());
216|
217|                    let section_path = self.get_section_path(ref_id);
218|
219|                    parents.push(ParentDocumentInfo {
220|                        key: doc_key.to_string(),
221|                        title,
222|                        section_path,
223|                    });
224|                }
225|            }
226|        }
227|
228|        parents.into_iter().unique_by(|p| p.key.clone()).collect()
229|    }
230|
231|    fn get_section_path(&self, node_id: NodeId) -> Vec<String> {
232|        let mut path = Vec::new();
233|        let mut current = self.graph.node(node_id);
234|
235|        while let Some(parent) = current.to_parent() {
236|            if parent.is_section()
237|                && parent
238|                    .to_parent()
239|                    .map(|p| p.is_document())
240|                    .unwrap_or(true)
241|            {
242|                let text = parent.plain_text().trim().to_string();
243|                path.push(text);
244|            }
245|            if parent.is_document() {
246|                break;
247|            }
248|            current = parent;
249|        }
250|        path
251|    }
252|
253|    fn metadata_matches(&self, key: &Key, filters: &[(String, String)]) -> bool {
254|        let raw = match self.graph.get_metadata(key) {
255|            Some(s) => s,
256|            None => return false,
257|        };
258|        let val: serde_yaml::Value = match serde_yaml::from_str(raw) {
259|            Ok(v) => v,
260|            _ => return false,
261|        };
262|        filters.iter().all(|(k, v)| {
263|            val.get(k.as_str())
264|                .and_then(|node| match node {
265|                    serde_yaml::Value::String(s) => Some(s.as_str() == v.as_str()),
266|                    serde_yaml::Value::Bool(b) => Some(b.to_string() == *v),
267|                    serde_yaml::Value::Number(n) => Some(n.to_string() == *v),
268|                    serde_yaml::Value::Sequence(items) => Some(
269|                        items
270|                            .iter()
271|                            .any(|i| i.as_str().map(|s| s == v.as_str()).unwrap_or(false)),
272|                    ),
273|                    _ => Some(false),
274|                })
275|                .unwrap_or(false)
276|        })
277|    }
