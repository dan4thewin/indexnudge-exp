880|fn build_tree_node(
881|    graph: &Graph,
882|    key: &Key,
883|    max_depth: u8,
884|    visited: &mut std::collections::HashSet<Key>,
885|) -> Option<TreeNode> {
886|    graph.get_node_id(key)?;
887|
888|    let title = graph.get_ref_text(key).unwrap_or_default();
889|    let key_str = key.to_string();
890|
891|    if visited.contains(key) {
892|        return Some(TreeNode {
893|            key: key_str,
894|            title,
895|            children: vec![],
896|        });
897|    }
898|    visited.insert(key.clone());
899|
900|    let children = if max_depth > 1 {
901|        let ref_node_ids = graph.get_block_references_in(key);
902|        ref_node_ids
903|            .iter()
904|            .filter_map(|id| graph.graph_node(*id).ref_key())
905|            .sorted()
906|            .filter_map(|ref_key| build_tree_node(graph, &ref_key, max_depth - 1, visited))
907|            .collect()
908|    } else {
909|        vec![]
910|    };
911|
912|    Some(TreeNode {
913|        key: key_str,
914|        title,
915|        children,
916|    })
917|}
918|
919|#[allow(clippy::too_many_arguments)]
920|fn build_tree_lines(
921|    graph: &Graph,
922|    key: &Key,
923|    depth: u8,
924|    max_depth: u8,
925|    format: &TreeFormat,
926|    visited: &mut std::collections::HashSet<Key>,
927|    tree_lines: &mut std::collections::BTreeMap<String, Vec<(usize, String)>>,
928|    root_key_str: &str,
929|) {
930|    if depth > max_depth {
931|        return;
932|    }
933|
934|    if graph.get_node_id(key).is_none() {
935|        return;
936|    }
937|
938|    let line = match format {
939|        TreeFormat::Keys => key.to_string(),
940|        TreeFormat::Markdown => {
941|            let text = graph.get_ref_text(key).unwrap_or_default();
942|            format!("[{}]({})", text, key)
943|        }
944|        TreeFormat::Json => unreachable!(),
945|    };
946|
947|    tree_lines
948|        .entry(root_key_str.to_string())
949|        .or_default()
950|        .push((depth as usize, line));
951|
952|    if visited.contains(key) {
953|        return;
954|    }
955|    visited.insert(key.clone());
956|
957|    let ref_node_ids = graph.get_block_references_in(key);
958|    let ref_keys: Vec<Key> = ref_node_ids
959|        .iter()
960|        .filter_map(|id| graph.graph_node(*id).ref_key())
961|        .sorted()
962|        .collect();
963|    for ref_key in &ref_keys {
964|        build_tree_lines(
965|            graph,
966|            ref_key,
967|            depth + 1,
968|            max_depth,
969|            format,
970|            visited,
971|            tree_lines,
972|            root_key_str,
973|        );
974|    }
975|}
