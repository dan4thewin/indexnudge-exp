773|fn open_in_editor(path: &std::path::Path) {
774|    let editor = env::var("EDITOR").unwrap_or_else(|_| "vim".to_string());
775|
776|    let status = ProcessCommand::new(&editor).arg(path).status();
777|
778|    match status {
779|        Ok(exit_status) => {
780|            if !exit_status.success() {
781|                error!("Editor exited with non-zero status");
782|            }
783|        }
784|        Err(e) => {
785|            error!("Failed to open editor '{}': {}", editor, e);
786|        }
787|    }
788|}
