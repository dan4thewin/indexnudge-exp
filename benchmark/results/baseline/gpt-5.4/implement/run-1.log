791|fn tree_command(args: TreeArgs) {
792|    let config = get_configuration();
793|    let graph = load_graph(&config);
794|
795|    let selector: liwe::selector::Selector = args.selector.into();
796|
797|    let explicit_keys: Vec<Key> = args.key.iter().map(|k| Key::name(k)).collect();
798|
799|    let root_keys: Vec<Key> = if !selector.is_empty() {
800|        let selector_set = selector.resolve(&graph);
801|        if explicit_keys.is_empty() {
802|            let mut v: Vec<Key> = selector_set.into_iter().collect();
803|            v.sort();
804|            v
805|        } else {
806|            explicit_keys
807|                .into_iter()
808|                .filter(|k| selector_set.contains(k))
809|                .collect()
810|        }
811|    } else if explicit_keys.is_empty() {
812|        let paths = graph.paths();
813|        paths
814|            .iter()
815|            .filter(|n| n.ids().len() == 1)
816|            .filter_map(|n| n.first_id())
817|            .map(|id| (&graph).node(id).node_key())
818|            .sorted()
819|            .unique()
820|            .collect()
821|    } else {
822|        explicit_keys
823|    };
824|
825|    for root_key in &root_keys {
826|        if (&graph).get_node_id(root_key).is_none() {
827|            eprintln!("Error: Document '{}' not found", root_key);
828|            std::process::exit(1);
829|        }
830|    }
831|
832|    match args.format {
833|        TreeFormat::Json => {
834|            let mut trees: Vec<TreeNode> = Vec::new();
835|            for root_key in &root_keys {
836|                let mut visited: std::collections::HashSet<Key> = std::collections::HashSet::new();
837|                if let Some(node) = build_tree_node(&graph, root_key, args.depth, &mut visited) {
838|                    trees.push(node);
839|                }
840|            }
841|            let json = serde_json::to_string_pretty(&trees).expect("Failed to serialize to JSON");
842|            println!("{}", json);
843|        }
844|        _ => {
845|            let mut tree_lines: std::collections::BTreeMap<String, Vec<(usize, String)>> =
846|                std::collections::BTreeMap::new();
847|
848|            for root_key in &root_keys {
849|                let root_key_str = root_key.to_string();
850|                let mut visited: std::collections::HashSet<Key> = std::collections::HashSet::new();
851|                build_tree_lines(
852|                    &graph,
853|                    root_key,
854|                    1,
855|                    args.depth,
856|                    &args.format,
857|                    &mut visited,
858|                    &mut tree_lines,
859|                    &root_key_str,
860|                );
861|            }
862|
863|            for (_root, lines) in tree_lines {
864|                for (depth, line) in lines {
865|                    let indent = match args.format {
866|                        TreeFormat::Markdown => "  ".repeat(depth.saturating_sub(1)),
867|                        _ => "\t".repeat(depth.saturating_sub(1)),
868|                    };
869|                    let prefix = match args.format {
870|                        TreeFormat::Markdown => format!("{}- ", indent),
871|                        _ => indent,
872|                    };
873|                    println!("{}{}", prefix, line);
874|                }
875|            }
876|        }
877|    }
