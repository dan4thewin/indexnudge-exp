#[test]
fn test_find_count_prints_total_only() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}

#[test]
fn test_find_count_respects_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join("source.md"),
        indoc! {"
            ---
            status: active
            ---
            # Source

            [target](target)
        "},
    )
    .unwrap();

    write(
        dir.path().join("other.md"),
        indoc! {"
            ---
            status: inactive
            ---
            # Other

            [target](target)
        "},
    )
    .unwrap();

    write(
        dir.path().join("target.md"),
        indoc! {"
            ---
            status: active
            ---
            # Target

            Content.
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &["--count", "--refs-to", "target", "--meta", "status=active"],
    );

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "1\n");
}
'''
if 'fn test_find_count_prints_total_only()' in text:
    raise SystemExit('tests already added')
path.write_text(text + append)
