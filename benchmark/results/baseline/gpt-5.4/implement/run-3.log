527|fn main() {
528|    debug!("parsing arguments");
529|    let app = App::parse();
530|
531|    if app.global_opts.verbose > 1 {
532|        tracing_subscriber::fmt()
533|            .with_max_level(tracing::Level::DEBUG)
534|            .with_writer(std::io::stderr)
535|            .init();
536|    } else if app.global_opts.verbose > 0 {
537|        tracing_subscriber::fmt()
538|            .with_max_level(tracing::Level::INFO)
539|            .with_writer(std::io::stderr)
540|            .init();
541|    }
542|
543|    debug!("starting command processing");
544|    match app.command {
545|        Command::Normalize(normalize) => {
546|            normalize_command(normalize);
547|        }
548|        Command::Tree(tree) => {
549|            tree_command(tree);
550|        }
551|        Command::Squash(squash) => {
552|            squash_command(squash);
553|        }
554|        Command::Init(init) => init_command(init),
555|        Command::New(new) => new_command(new),
556|        Command::Retrieve(retrieve) => retrieve_command(retrieve),
557|        Command::Find(find) => find_command(find),
558|        Command::Export(export) => export_command(export),
559|        Command::Stats(stats) => stats_command(stats),
560|        Command::Rename(rename) => rename_command(rename),
561|        Command::Delete(delete) => delete_command(delete),
562|        Command::Extract(extract) => extract_command(extract),
563|        Command::Inline(inline) => inline_command(inline),
564|        Command::Update(update) => update_command(update),
565|        Command::Attach(attach) => attach_command(attach),
566|    }
