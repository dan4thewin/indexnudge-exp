#[test]
fn test_find_count_outputs_total_only() {
    let dir = setup_workspace();

    for name in [\"alpha\", \"beta\", \"gamma\"] {
        write(dir.path().join(format!(\"{}.md\", name)), format!(\"# {}\\n\\nContent.\", name)).unwrap();
    }

    let (stdout, stderr, success) = run_iwe(dir.path(), &[\"--count\"]);

    assert!(success, \"stderr: {}\", stderr);
    assert_eq!(stdout.trim(), \"3\");
}

#[test]
fn test_find_count_respects_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join(\"root.md\"),
        indoc! {\"\n            ---\n            status: active\n            ---\n            # Root\n\n            [target](target)\n        \"},
    )
    .unwrap();

    write(
        dir.path().join(\"leaf.md\"),
        indoc! {\"\n            ---\n            status: active\n            ---\n            # Leaf\n        \"},
    )
    .unwrap();

    write(
        dir.path().join(\"other.md\"),
        indoc! {\"\n            ---\n            status: inactive\n            ---\n            # Other\n\n            [target](target)\n        \"},
    )
    .unwrap();

    write(dir.path().join(\"target.md\"), \"# Target\\n\").unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &[
            \"--count\",
            \"--roots\",
            \"--refs-to\",
            \"target\",
            \"--meta\",
            \"status=active\",
        ],
    );

    assert!(success, \"stderr: {}\", stderr);
    assert_eq!(stdout.trim(), \"1\");
}
"""
if 'fn test_find_count_outputs_total_only()' in text:
    raise SystemExit('tests already added')
p.write_text(text + append)
