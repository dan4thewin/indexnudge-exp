#[test]
fn test_find_count_flag() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nAlpha content.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nBeta content.").unwrap();
    write(dir.path().join("gamma.md"), "# Gamma\n\nGamma content.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);
    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout.trim(), "3");
}

#[test]
fn test_find_count_with_query() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nAlpha content.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nBeta content.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["alpha", "--count"]);
    assert!(success, "stderr: {}", stderr);
    let count: usize = stdout.trim().parse().expect("should be a number");
    assert!(count >= 1, "should find at least alpha");
}

#[test]
fn test_find_count_with_roots() {
    let dir = setup_workspace();

    write(
        dir.path().join("parent.md"),
        "# Parent\n\nSee [child](child).\n",
    )
    .unwrap();
    write(dir.path().join("child.md"), "# Child\n\nChild content.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--roots", "--count"]);
    assert!(success, "stderr: {}", stderr);
    let count: usize = stdout.trim().parse().expect("should be a number");
    assert_eq!(count, 1, "only parent is a root");
}
TESTEOF

