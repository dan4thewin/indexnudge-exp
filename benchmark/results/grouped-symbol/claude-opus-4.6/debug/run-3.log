#[test]
fn debug_pulldown_events_multiline_complex() {
    use pulldown_cmark::*;
    
    // More complex YAML that might split into multiple text events
    let inputs = vec![
        ("simple", "---\ntitle: A\nstatus: ready\n---\n\n# A\n"),
        ("seq", "---\ntitle: A\ndepends:\n  - foo\n  - bar\n---\n\n# A\n"),
        ("long", "---\ntitle: A\ndepends:\n  - foo\n  - bar\n  - baz\n  - qux\n  - quux\n---\n\n# A\n"),
    ];
    
    let mut opts = Options::empty();
    opts.insert(Options::ENABLE_YAML_STYLE_METADATA_BLOCKS);
    
    for (label, input) in inputs {
        let parser = Parser::new_ext(input, opts);
        let mut text_count = 0;
        for event in parser {
            if let Event::Text(t) = &event {
                text_count += 1;
                eprintln!("{}: Text #{}: {:?}", label, text_count, t.as_ref());
            }
        }
        eprintln!("{}: total text events in metadata = {}", label, text_count - 1); // -1 for heading text
    }
}
EOF
