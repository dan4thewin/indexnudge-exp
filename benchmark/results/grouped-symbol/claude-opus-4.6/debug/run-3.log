#[test]
fn bare_frontmatter_meta_filter_no_trailing_newline() {
    // Real files might not have trailing newline after last line before blank line
    // Or might have different whitespace patterns
    let raw = "title: Task A\ndepends:\n  - foo\n  - bar\n\n# Task A\n";
    let graph = Graph::import(
        &vec![("1".to_string(), raw.to_string())].into_iter().collect(),
        MarkdownOptions {
            bare_frontmatter: true,
            ..Default::default()
        },
        None,
    );

    let meta = graph.get_metadata(&liwe::model::Key::name("1"));
    eprintln!("META FROM RAW: {:?}", meta);

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "raw content with sequence should match");
}

#[test]
fn bare_frontmatter_meta_filter_with_tabs() {
    // What if indentation uses tabs?
    let raw = "title: Task A\ndepends:\n\t- foo\n\n# Task A\n";
    let graph = Graph::import(
        &vec![("1".to_string(), raw.to_string())].into_iter().collect(),
        MarkdownOptions {
            bare_frontmatter: true,
            ..Default::default()
        },
        None,
    );
    let meta = graph.get_metadata(&liwe::model::Key::name("1"));
    eprintln!("META WITH TABS: {:?}", meta);
}
EOF
