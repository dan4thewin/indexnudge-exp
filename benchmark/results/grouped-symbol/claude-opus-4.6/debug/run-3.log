#[test]
fn bare_frontmatter_realistic_tibbitwiki() {
    // TibbitWiki-style bare frontmatter: created/modified/title then blank line then body
    // But what about multi-value fields?
    // TibbitWiki pages typically have simple key: value pairs, no sequences
    // Let me test the actual user report: depends field with list items
    
    // The key question: does the user's file have `- foo` continuation lines
    // that DON'T start with space? Or DO start with space?
    
    // Standard YAML: sequences can be:
    //   depends:
    //   - foo        (no indent - VALID YAML)
    //   depends:
    //     - foo      (indented - VALID YAML)
    
    // Case 1: no indent (- starts at column 0)
    let content1 = "title: Task A\ndepends:\n- foo\n\n# Task A\n";
    let wrapped1 = liwe::markdown::wrap_bare_frontmatter(content1);
    eprintln!("NO INDENT WRAPPED: {:?}", wrapped1.as_ref());
    
    // Case 2: indented (- starts at column 2)  
    let content2 = "title: Task A\ndepends:\n  - foo\n\n# Task A\n";
    let wrapped2 = liwe::markdown::wrap_bare_frontmatter(content2);
    eprintln!("INDENTED WRAPPED: {:?}", wrapped2.as_ref());
    
    // Both should work!
    for (label, content) in [("no-indent", content1), ("indented", content2)] {
        let graph = Graph::import(
            &vec![("1".to_string(), content.to_string())].into_iter().collect(),
            MarkdownOptions {
                bare_frontmatter: true,
                ..Default::default()
            },
            None,
        );
        let meta = graph.get_metadata(&liwe::model::Key::name("1"));
        eprintln!("{}: meta = {:?}", label, meta);
        let raw = meta.unwrap();
        let val: serde_yaml::Value = serde_yaml::from_str(raw).unwrap();
        let depends = val.get("depends");
        eprintln!("{}: depends = {:?}", label, depends);
        assert!(depends.is_some(), "{}: depends should exist", label);
        if let Some(serde_yaml::Value::Sequence(items)) = depends {
            assert!(items.iter().any(|i| i.as_str() == Some("foo")), "{}: should contain foo", label);
        } else {
            panic!("{}: depends should be a sequence", label);
        }
    }
}
EOF
