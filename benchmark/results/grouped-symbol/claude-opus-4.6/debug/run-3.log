// Quick check: what does pulldown-cmark give us as metadata text?
use pulldown_cmark::{Parser, Options, Event, Tag, TagEnd};

fn main() {
    let fenced = "---\ntitle: Test\ndepends:\n  - foo\n---\n\n# Body\n";
    let bare_wrapped = "---\ntitle: Test\ndepends:\n  - foo\n---\n\n# Body\n";
    
    let mut opts = Options::empty();
    opts.insert(Options::ENABLE_YAML_STYLE_METADATA_BLOCKS);
    
    for (label, input) in [("fenced", fenced), ("bare_wrapped", bare_wrapped)] {
        let parser = Parser::new_ext(input, opts);
        for event in parser {
            match event {
                Event::Text(t) => {
                    println!("{}: Text({:?})", label, t.as_ref());
                }
                Event::Start(Tag::MetadataBlock(_)) => println!("{}: MetadataBlock start", label),
                Event::End(TagEnd::MetadataBlock(_)) => println!("{}: MetadataBlock end", label),
                _ => {}
            }
        }
    }
}
