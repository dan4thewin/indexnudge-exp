#[test]
fn bare_frontmatter_meta_filter_with_sequence() {
    let graph = Graph::import(
        &from_indoc(indoc! {"
            title: Task A
            depends:
              - foo
              - bar

            # Task A
        "}),
        MarkdownOptions {
            bare_frontmatter: true,
            ..Default::default()
        },
        None,
    );

    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "bare frontmatter with sequence should match meta filter");
    assert_eq!(output.results[0].title, "Task A");
}
