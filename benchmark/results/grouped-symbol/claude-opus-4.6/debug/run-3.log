#[test]
fn bare_frontmatter_meta_from_file_simulation() {
    // Simulate what from_indoc does - it calls .trim()
    let indoc_input = indoc::indoc! {"
        title: Task A
        depends:
          - foo
          - bar

        # Task A
    "};
    // from_indoc splits on \n_\n and trims each piece
    let trimmed = indoc_input.trim().to_string();
    eprintln!("TRIMMED: {:?}", trimmed);
    
    // Now simulate what new_for_path does - fs::read_to_string (no trim)
    let from_file = "title: Task A\ndepends:\n  - foo\n  - bar\n\n# Task A\n".to_string();
    eprintln!("FROM FILE: {:?}", from_file);
    
    // These should be the same
    assert_eq!(trimmed, from_file.trim());
    
    // But from_indoc uses .trim() while from_file doesn't!
    // Let's test with the untrimmed version
    let graph = Graph::import(
        &vec![("1".to_string(), from_file.clone())].into_iter().collect(),
        MarkdownOptions {
            bare_frontmatter: true,
            ..Default::default()
        },
        None,
    );
    let meta = graph.get_metadata(&liwe::model::Key::name("1"));
    eprintln!("META (from_file sim): {:?}", meta);
    assert!(meta.is_some());
    
    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1);
}
EOF
