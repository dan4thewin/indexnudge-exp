#[test]
fn bare_frontmatter_sequence_indented_with_spaces_only() {
    // This is the exact pattern that would appear in a real file:
    // bare frontmatter with a YAML list using "- " continuation lines
    // that start with spaces (not "  - " but just continuation)
    let content = "title: Task A\ndepends:\n- foo\n- bar\n\n# Task A\n";
    let graph = Graph::import(
        &vec![("1".to_string(), content.to_string())].into_iter().collect(),
        MarkdownOptions {
            bare_frontmatter: true,
            ..Default::default()
        },
        None,
    );
    let meta = graph.get_metadata(&liwe::model::Key::name("1"));
    eprintln!("META no-indent: {:?}", meta);
    
    let finder = DocumentFinder::new(&graph);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "bare frontmatter with unindented sequence should match");
}
