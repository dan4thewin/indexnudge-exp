#[test]
fn bare_frontmatter_blank_line_inside_yaml() {
    // What if there's a blank line INSIDE the YAML sequence?
    // e.g., between list items — this would split the header early!
    let content = "title: Task A\ndepends:\n  - foo\n\n  - bar\n\n# Task A\n";
    eprintln!("CONTENT: {:?}", content);
    
    // wrap_bare_frontmatter splits on first \n\n
    let wrapped = liwe::markdown::wrap_bare_frontmatter(content);
    eprintln!("WRAPPED: {:?}", wrapped.as_ref());
    
