#[test]
fn bare_frontmatter_roundtrip_preserves_sequence_metadata() {
    // Import bare frontmatter with sequence
    let content = "title: Task A\ndepends:\n  - foo\n  - bar\n\n# Task A\n";
    let opts = MarkdownOptions {
        bare_frontmatter: true,
        ..Default::default()
    };
    let graph = Graph::import(
        &vec![("1".to_string(), content.to_string())].into_iter().collect(),
        opts.clone(),
        None,
    );
    
    // Export (round-trip)
    let exported = graph.export();
    let exported_content = exported.get("1").unwrap();
    eprintln!("EXPORTED: {:?}", exported_content);
    
    // Re-import the exported content
    let graph2 = Graph::import(
        &exported.clone(),
        opts.clone(),
        None,
    );
    let meta2 = graph2.get_metadata(&liwe::model::Key::name("1"));
    eprintln!("META AFTER ROUNDTRIP: {:?}", meta2);
    
    // Check that depends: foo still matches
    let finder = DocumentFinder::new(&graph2);
    let options = FindOptions {
        metadata_filters: vec![("depends".to_string(), "foo".to_string())],
        ..Default::default()
    };
    let output = finder.find(&options);
    assert_eq!(output.results.len(), 1, "roundtripped bare frontmatter should still match meta filter");
}
EOF
