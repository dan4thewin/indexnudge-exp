        graph_to_paths(self)
    }

    pub fn update_key(&mut self, key: Key, content: &str) -> &mut Graph {
        if let Some(id) = self.keys.get(&key) {
            self.arena.delete_branch(*id);
        }

        self.from_markdown(key, content, MarkdownReader::new());

        self
    }

