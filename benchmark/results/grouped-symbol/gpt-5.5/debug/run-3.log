   623	fn add_default_type_to_actions(input: &str) -> String {
   624	    let mut doc = input.parse::<DocumentMut>().expect("valid TOML");
   625	
   626	    if let Some(Item::Table(actions)) = doc.get_mut("actions") {
   627	        for (_, action) in actions.iter_mut() {
   628	            if let Item::Table(action_table) = action {
   629	                action_table.entry("type").or_insert(value("transform"));
   630	            }
   631	        }
   632	    }
   633	
   634	    doc.to_string()
   635	}
