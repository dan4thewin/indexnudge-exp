    20	fn expand_env_var(value: &str) -> String {
    21	    let mut result = value.to_string();
    22	    let mut i = 0;
    23	    while i < result.len() {
    24	        if result[i..].starts_with('$') {
    25	            let rest = &result[i + 1..];
    26	            let (var_name, end_offset) = if rest.starts_with('{') {
    27	                if let Some(close) = rest.find('}') {
    28	                    (&rest[1..close], close + 2)
    29	                } else {
    30	                    i += 1;
    31	                    continue;
    32	                }
    33	            } else {
    34	                let end = rest
    35	                    .find(|c: char| !c.is_alphanumeric() && c != '_')
    36	                    .unwrap_or(rest.len());
    37	                if end == 0 {
    38	                    i += 1;
    39	                    continue;
    40	                }
    41	                (&rest[..end], end + 1)
    42	            };
    43	            let replacement = std::env::var(var_name).unwrap_or_default();
    44	            result = format!("{}{}{}", &result[..i], replacement, &result[i + end_offset..]);
    45	            i += replacement.len();
    46	        } else {
    47	            i += 1;
    48	        }
    49	    }
    50	    result
    51	}
