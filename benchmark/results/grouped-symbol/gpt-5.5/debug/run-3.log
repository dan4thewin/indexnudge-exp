   567	    let current_version = doc
   568	        .get("version")
   569	        .and_then(|v| v.as_value())
   570	        .and_then(|v| v.as_integer())
   571	        .unwrap_or(0);
   572	
   573	    let mut updated = config.to_string();
   574	    let mut needs_update = false;
   575	
   576	    // Migrate from version 0 to version 1
   577	    if current_version < 1 {
   578	        debug!("applying migrations from version 0 to 1");
   579	        updated = add_default_type_to_actions(&updated);
   580	        updated = add_default_code_actions(&updated);
   581	        updated = set_config_version(&updated, 1);
   582	        needs_update = true;
   583	    }
   584	
   585	    // Migrate from version 1 to version 2
   586	    if current_version < 2 {
   587	        debug!("applying migrations from version 1 to 2");
   588	        updated = add_refs_extension_field(&updated);
   589	        updated = add_link_action(&updated);
   590	        updated = set_config_version(&updated, 2);
   591	        needs_update = true;
   592	    }
   593	
   594	    // Migrate from version 2 to version 3
   595	    if current_version < 3 {
   596	        debug!("applying migrations from version 2 to 3");
   597	        updated = migrate_v2_to_v3(&updated);
   598	        updated = set_config_version(&updated, 3);
   599	        needs_update = true;
   600	    }
   601	
   602	    // Migrate from version 3 to version 4
   603	    if current_version < 4 {
   604	        debug!("applying migrations from version 3 to 4");
   605	        updated = set_config_version(&updated, 4);
   606	        needs_update = true;
   607	    }
   608	
   609	    if needs_update {
   610	        debug!("configuration file migration applied");
   611	        let current_dir = env::current_dir().expect("to get current dir");
   612	        let mut config_path = current_dir.clone();
   613	        config_path.push(IWE_MARKER);
   614	        config_path.push(CONFIG_FILE_NAME);
   615	
   616	        debug!("updating configuration file");
   617	        std::fs::write(config_path, &updated).expect("to write updated config file");
   618	    }
   619	
   620	    updated
   621	}
