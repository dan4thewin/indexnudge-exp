    53	fn execute_command(cmd: &Command, input: &str) -> Option<String> {
    54	    let timeout = cmd.timeout_seconds.unwrap_or(120);
    55	    let use_shell = cmd.shell.unwrap_or(true);
    56	
    57	    let mut process = if use_shell {
    58	        let mut p = ProcessCommand::new("sh");
    59	        p.arg("-c").arg(&cmd.run);
    60	        p
    61	    } else {
    62	        let mut p = ProcessCommand::new(&cmd.run);
    63	        if let Some(args) = &cmd.args {
    64	            p.args(args);
    65	        }
    66	        p
    67	    };
    68	
    69	    if let Some(cwd) = &cmd.cwd {
    70	        process.current_dir(cwd);
    71	    }
    72	
    73	    if let Some(env) = &cmd.env {
    74	        for (key, value) in env {
    75	            let expanded = expand_env_var(value);
    76	            process.env(key, expanded);
    77	        }
    78	    }
    79	
    80	    process
    81	        .stdin(Stdio::piped())
    82	        .stdout(Stdio::piped())
    83	        .stderr(Stdio::piped());
    84	
    85	    let mut child = process.spawn().ok()?;
    86	
    87	    if let Some(mut stdin) = child.stdin.take() {
    88	        stdin.write_all(input.as_bytes()).ok()?;
    89	    }
    90	
    91	    let output = wait_with_timeout(&mut child, Duration::from_secs(timeout))?;
    92	
    93	    if output.status.success() {
    94	        Some(String::from_utf8_lossy(&output.stdout).to_string())
    95	    } else {
    96	        None
    97	    }
    98	}
    99	
   100	fn wait_with_timeout(
   101	    child: &mut std::process::Child,
   102	    timeout: Duration,
   103	) -> Option<std::process::Output> {
   104	    use std::thread;
   105	    use std::time::Instant;
   106	
   107	    let start = Instant::now();
   108	    let poll_interval = Duration::from_millis(100);
   109	
   110	    loop {
   111	        match child.try_wait() {
   112	            Ok(Some(status)) => {
   113	                let stdout = child
   114	                    .stdout
   115	                    .take()
   116	                    .map(|mut s| {
   117	                        let mut buf = Vec::new();
   118	                        std::io::Read::read_to_end(&mut s, &mut buf).ok();
   119	                        buf
   120	                    })
   121	                    .unwrap_or_default();
   122	                let stderr = child
   123	                    .stderr
   124	                    .take()
   125	                    .map(|mut s| {
   126	                        let mut buf = Vec::new();
   127	                        std::io::Read::read_to_end(&mut s, &mut buf).ok();
   128	                        buf
   129	                    })
   130	                    .unwrap_or_default();
   131	                return Some(std::process::Output {
   132	                    status,
   133	                    stdout,
   134	                    stderr,
   135	                });
   136	            }
   137	            Ok(None) => {
   138	                if start.elapsed() >= timeout {
   139	                    let _ = child.kill();
   140	                    return None;
   141	                }
   142	                thread::sleep(poll_interval);
   143	            }
   144	            Err(_) => return None,
   145	        }
   146	    }
   147	}
