26,55c
/// If `bare_frontmatter` is enabled and content starts with a YAML mapping
/// block (but not `---`), wrap the leading header block in `---` fences so the
/// downstream pulldown-cmark MetadataBlock machinery picks it up.
pub fn wrap_bare_frontmatter(content: &str) -> Cow<'_, str> {
    // Already fenced — leave alone.
    if content.starts_with("---") {
        return Cow::Borrowed(content);
    }

    // Find first true blank line (\n\n or \r\n\r\n).
    let (header, rest) = if let Some(pos) = content.find("\n\n") {
        (&content[..pos], &content[pos + 2..])
    } else if let Some(pos) = content.find("\r\n\r\n") {
        (&content[..pos], &content[pos + 4..])
    } else {
        // No blank line — entire content is a candidate header.
        (content.trim_end(), "")
    };

    if !is_bare_frontmatter(header) {
        return Cow::Borrowed(content);
    }

    if rest.is_empty() {
        Cow::Owned(format!("---\n{}\n---\n", header))
    } else {
        Cow::Owned(format!("---\n{}\n---\n\n{}", header, rest))
    }
}

fn is_bare_frontmatter(header: &str) -> bool {
    if header.is_empty() {
        return false;
    }

    let mut saw_key = false;
    for line in header.lines() {
        if line.starts_with(' ') || line.starts_with('\t') {
            continue;
        }
        if !is_bare_metadata_key_line(line) {
            return false;
        }
        saw_key = true;
    }

    if !saw_key {
        return false;
    }

    matches!(
        serde_yaml::from_str::<serde_yaml::Value>(header),
        Ok(serde_yaml::Value::Mapping(_))
    )
}

fn is_bare_metadata_key_line(line: &str) -> bool {
    let Some((key, rest)) = line.split_once(':') else {
        return false;
    };

    let mut chars = key.chars();
    let Some(first) = chars.next() else {
        return false;
    };

    if !first.is_ascii_lowercase() {
        return false;
    }

    if !chars.all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == '_' || c == '-') {
        return false;
    }

    rest.is_empty() || rest.starts_with(' ')
}
