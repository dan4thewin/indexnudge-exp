+        return false;
+    }
+
+    matches!(
+        serde_yaml::from_str::<serde_yaml::Value>(header),
+        Ok(serde_yaml::Value::Mapping(_))
+    )
+}
+
+fn is_bare_metadata_key_line(line: &str) -> bool {
+    let Some((key, rest)) = line.split_once(':') else {
+        return false;
+    };
+
