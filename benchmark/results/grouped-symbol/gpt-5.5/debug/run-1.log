+        indoc! {"
+            title: Task A
+            depends:
+              - foo
+
+            # Task A
+        "},
+    )
+    .unwrap();
+
+    let nested_dir = dir.path().join("nested");
+    create_dir_all(&nested_dir).expect("Should create nested directory");
+
+    let (stdout, stderr, success) =
+        run_iwe(&nested_dir, &["--meta", "depends=foo", "-f", "json"]);
+
+    assert!(success, "stderr: {}", stderr);
+
+    let parsed: serde_json::Value = serde_json::from_str(&stdout).expect("valid JSON");
+    assert_eq!(parsed["total"], 1);
+    assert_eq!(parsed["results"][0]["key"], "task");
+    assert_eq!(parsed["results"][0]["title"], "Task A");
+}
