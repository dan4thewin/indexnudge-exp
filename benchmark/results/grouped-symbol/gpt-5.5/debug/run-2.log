  ── from_indoc (L14-L20) ──
  14 │ pub fn from_indoc(indoc: &str) -> State {
  15 │     indoc
  16 │         .split("\n_\n")
  17 │         .enumerate()
  18 │         .map(|(index, text)| ((index + 1).to_string(), text.trim().to_string()))
  19 │         .collect()
  20 │ }
  21 │ 

  ── from_indoc_sub (L22-L35) ──
  22 │ pub fn from_indoc_sub(indoc: &str) -> State {
  23 │     indoc
  24 │         .split("\n_\n")
  25 │         .enumerate()
  26 │         .map(|(index, text)| {
  27 │             let name = if index == 0 {
  28 │                 "1".to_string()
  29 │             } else {
  30 │                 format!("d/{}", index + 1)
  31 │             };
  32 │             (name.to_string(), text.trim().to_string())
  33 │         })
  34 │         .collect()
  35 │ }
