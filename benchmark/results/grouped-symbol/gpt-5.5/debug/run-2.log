#[test]
fn test_find_meta_matches_bare_frontmatter_yaml_sequence() {
    let dir = setup_workspace();

    let config = Configuration {
        library: LibraryOptions {
            path: "".to_string(),
            ..Default::default()
        },
        markdown: MarkdownOptions {
            refs_extension: "".to_string(),
            bare_frontmatter: true,
            ..Default::default()
        },
        ..Default::default()
    };
    let config_content = toml::to_string(&config).expect("Failed to serialize config to TOML");
    write(dir.path().join(".iwe").join("config.toml"), config_content)
        .expect("Should write config file");

    write(
        dir.path().join("bare.md"),
        indoc! {"
            title: Bare
            depends:
              - foo
              - bar

            # Bare
        "},
    )
    .unwrap();

    write(
        dir.path().join("other.md"),
        indoc! {"
            title: Other
            depends:
              - baz

            # Other
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--meta", "depends=foo", "-f", "json"]);

    assert!(success, "stderr: {}", stderr);

    let parsed: serde_json::Value = serde_json::from_str(&stdout).expect("valid JSON");
    assert_eq!(parsed["total"], 1);
    let results = parsed["results"].as_array().unwrap();
    assert_eq!(results[0]["key"], "bare");
}
EOF
