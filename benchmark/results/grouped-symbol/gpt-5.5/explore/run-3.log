17|pub struct FindResult {
18|    pub key: String,
19|    pub title: String,
20|    pub display_title: String,
21|    pub is_root: bool,
22|    pub incoming_refs: usize,
23|    pub outgoing_refs: usize,
24|    pub parent_documents: Vec<ParentDocumentInfo>,
25|}
26|
27|#[derive(Debug, Clone, Serialize)]
28|pub struct FindOutput {
29|    pub query: Option<String>,
30|    pub limit: Option<usize>,
31|    pub total: usize,
32|    pub results: Vec<FindResult>,
33|}
