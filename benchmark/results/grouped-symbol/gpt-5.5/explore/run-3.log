8|
9|pub fn write_file(key: &String, content: &Content, to: &Path) -> std::io::Result<()> {
10|    fs::write(to.join(format!("{}.md", key)), content.as_str())
11|}
12|
13|pub fn new_for_path(base_path: &PathBuf) -> State {
14|    new_for_path_with_options(base_path, false)
15|}
16|
17|pub fn new_for_path_with_options(base_path: &PathBuf, virtual_directories: bool) -> State {
18|    if !base_path.exists() {
19|        error!("path doesn't exist");
20|        return State::new();
21|    }
22|
23|    if virtual_directories {
24|        generate_virtual_indices(base_path);
25|    }
26|
27|    WalkBuilder::new(base_path)
28|        .follow_links(false)
29|        .hidden(true)
30|        .require_git(false)
31|        .build()
32|        .filter_map(|entry| {
33|            let entry = entry.ok()?;
34|            let path = entry.path();
35|
36|            if !path.is_file() || path.extension().is_none_or(|ext| ext != "md") {
37|                return None;
38|            }
39|
40|            let relative_path = path.strip_prefix(base_path).ok()?;
41|            let key = if let Some(parent) = relative_path.parent() {
42|                if parent == std::path::Path::new("") {
43|                    to_file_name(path)
44|                } else {
45|                    format!("{}/{}", parent.to_string_lossy(), to_file_name(path))
46|                }
47|            } else {
48|                to_file_name(path)
49|            };
50|
51|            fs::read_to_string(path).ok().map(|content| (key, content))
52|        })
53|        .collect()
54|}
55|
56|pub fn new_from_hashmap(map: HashMap<String, String>) -> State {
57|    map.into_iter().collect()
58|}
59|
60|pub fn write_store_at_path(store: &State, to: &Path) -> std::io::Result<()> {
61|    for (key, content) in store.iter() {
62|        write_file(key, content, to)?;
63|    }
64|    Ok(())
65|}
66|
67|fn to_file_name(path: &Path) -> String {
68|    let name = path
69|        .file_name()
70|        .map(|name| name.to_string_lossy().trim_end_matches(".md").to_string())
71|        .unwrap_or_default();
72|
73|    // Strip leading `_` for virtual directory index files
74|    if name.starts_with('_') {
75|        name[1..].to_string()
76|    } else {
77|        name
78|    }
79|}
80|
81|/// Scan `base_path` for directories that transitively contain `.md` files
82|/// and generate/maintain `_dirname.md` index files.
83|fn generate_virtual_indices(base_path: &Path) {
84|    use std::collections::{BTreeSet, HashSet};
85|
86|    // Collect all directories that transitively contain .md files.
87|    let mut dirs_with_md: HashSet<PathBuf> = HashSet::new();
88|
89|    for entry in WalkBuilder::new(base_path)
90|        .follow_links(false)
91|        .hidden(true)
92|        .require_git(false)
93|        .build()
94|        .flatten()
95|    {
96|        let path = entry.path();
97|        if path.is_file() && path.extension().is_some_and(|ext| ext == "md") {
98|            // Walk up from parent to base, marking each as containing .md
99|            let mut dir = path.parent();
100|            while let Some(d) = dir {
101|                if d == base_path {
102|                    break;
103|                }
104|                if !dirs_with_md.insert(d.to_path_buf()) {
105|                    break; // already visited
106|                }
107|                dir = d.parent();
108|            }
109|        }
110|    }
111|
112|    // For each directory with .md files, generate or maintain index.
113|    for dir in &dirs_with_md {
114|        let dir_name = match dir.file_name() {
115|            Some(n) => n.to_string_lossy().to_string(),
116|            None => continue,
117|        };
118|
119|        let parent = match dir.parent() {
120|            Some(p) => p,
121|            None => continue,
122|        };
123|
124|        let user_index = parent.join(format!("{}.md", dir_name));
125|        let generated_index = parent.join(format!("_{}.md", dir_name));
126|
127|        // If user index exists, delete generated if present, skip.
128|        if user_index.exists() {
129|            if generated_index.exists() {
130|                let _ = fs::remove_file(&generated_index);
131|            }
132|            continue;
133|        }
134|
135|        // Collect children: .md files directly in dir (excluding _*.md generated indices)
136|        // and subdirectories that are in dirs_with_md.
137|        let mut children_keys: BTreeSet<String> = BTreeSet::new();
138|
139|        let relative_dir = dir.strip_prefix(base_path).unwrap_or(Path::new(""));
140|
141|        // Direct .md files in this directory
142|        if let Ok(entries) = fs::read_dir(dir) {
143|            for entry in entries.flatten() {
144|                let p = entry.path();
145|                if p.is_file() && p.extension().is_some_and(|ext| ext == "md") {
146|                    let fname = p
147|                        .file_name()
148|                        .map(|n| n.to_string_lossy().to_string())
149|                        .unwrap_or_default();
150|                    // Skip generated index files
151|                    if fname.starts_with('_') {
152|                        continue;
153|                    }
154|                    let key_name = fname.trim_end_matches(".md");
155|                    let child_key = format!(
156|                        "{}/{}",
157|                        relative_dir.to_string_lossy(),
158|                        key_name
159|                    );
160|                    children_keys.insert(child_key);
161|                } else if p.is_dir() && dirs_with_md.contains(&p) {
162|                    let subdir_name = p
163|                        .file_name()
164|                        .map(|n| n.to_string_lossy().to_string())
165|                        .unwrap_or_default();
166|                    let child_key = format!(
167|                        "{}/{}",
168|                        relative_dir.to_string_lossy(),
169|                        subdir_name
170|                    );
171|                    children_keys.insert(child_key);
172|                }
173|            }
174|        }
175|
176|        if children_keys.is_empty() {
177|            continue;
178|        }
179|
180|        // Generate content
181|        let mut content = format!("# {}\n", dir_name);
182|        for child_key in &children_keys {
183|            let link_text = child_key.rsplit('/').next().unwrap_or(child_key);
184|            content.push_str(&format!("\n[{}]({})\n", link_text, child_key));
185|        }
186|
187|        // Check if regeneration needed
188|        if generated_index.exists() {
189|            if let Ok(existing) = fs::read_to_string(&generated_index) {
190|                if existing == content {
191|                    continue; // up to date
192|                }
193|            }
194|        }
195|
196|        let _ = fs::write(&generated_index, &content);
197|    }
198|}
