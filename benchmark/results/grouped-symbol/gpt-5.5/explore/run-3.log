6|#[derive(Debug, Clone)]
7|pub struct KeyDepth {
8|    pub key: Key,
9|    pub depth: Option<u8>,
10|}
11|
12|impl KeyDepth {
13|    pub fn bare(key: Key) -> Self {
14|        Self { key, depth: None }
15|    }
16|
17|    pub fn with_depth(key: Key, depth: u8) -> Self {
18|        Self { key, depth: Some(depth) }
19|    }
