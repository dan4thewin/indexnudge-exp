#[test]
fn test_find_count_all_documents() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nContent.").unwrap();
    write(dir.path().join("gamma.md"), "# Gamma\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "3\n");
}

#[test]
fn test_find_count_respects_filters_and_ignores_limit_and_format() {
    let dir = setup_workspace();

    write(
        dir.path().join("parent.md"),
        indoc! {"
            ---
            status: ready
            ---
            # Parent

            [child](child)
        "},
    )
    .unwrap();
    write(
        dir.path().join("orphan.md"),
        indoc! {"
            ---
            status: ready
            ---
            # Orphan
        "},
    )
    .unwrap();
    write(
        dir.path().join("child.md"),
        indoc! {"
            ---
            status: ready
            ---
            # Child
        "},
    )
    .unwrap();
    write(
        dir.path().join("draft.md"),
        indoc! {"
            ---
            status: draft
            ---
            # Draft
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &[
            "--roots",
            "--meta",
            "status=ready",
            "--limit",
            "1",
            "-f",
            "json",
            "--count",
        ],
    );

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}

#[test]
fn test_find_count_respects_refs_to() {
    let dir = setup_workspace();

    write(dir.path().join("doc1.md"), "# Doc One\n\n[target](target)").unwrap();
    write(dir.path().join("doc2.md"), "# Doc Two\n\n[target](target)").unwrap();
    write(dir.path().join("doc3.md"), "# Doc Three\n\nNo refs.").unwrap();
    write(dir.path().join("target.md"), "# Target\n\nTarget content.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--refs-to", "target", "--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}
