#[test]
fn test_find_count_prints_only_total() {
    let dir = setup_workspace();

    write(dir.path().join("alpha.md"), "# Alpha\n\nContent.").unwrap();
    write(dir.path().join("beta.md"), "# Beta\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}

#[test]
fn test_find_count_with_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join("ready-root.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Ready Root

            [target](target)
        "},
    )
    .unwrap();

    write(
        dir.path().join("ready-child.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Ready Child

            [target](target)
        "},
    )
    .unwrap();

    write(
        dir.path().join("parent.md"),
        indoc! {"
            # Parent

            [ready-child](ready-child)
        "},
    )
    .unwrap();

    write(
        dir.path().join("done-root.md"),
        indoc! {"
            ---
            status: done
            ---

            # Done Root

            [target](target)
        "},
    )
    .unwrap();

    write(dir.path().join("target.md"), "# Target\n\nContent.").unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &["--count", "--roots", "--refs-to", "target", "--meta", "status=ready"],
    );

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "1\n");
}

.
