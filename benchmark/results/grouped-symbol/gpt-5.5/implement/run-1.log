#[test]
fn test_find_count_lists_all_documents() {
    let dir = setup_workspace();

    write(dir.path().join("doc1.md"), "# Document One\n\nContent one.").unwrap();
    write(dir.path().join("doc2.md"), "# Document Two\n\nContent two.").unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "2\n");
}

#[test]
fn test_find_count_with_filters() {
    let dir = setup_workspace();

    write(
        dir.path().join("root-ready.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Root Ready

            [child](child)
        "},
    )
    .unwrap();
    write(
        dir.path().join("root-done.md"),
        indoc! {"
            ---
            status: done
            ---

            # Root Done

            [child](child)
        "},
    )
    .unwrap();
    write(
        dir.path().join("child.md"),
        indoc! {"
            ---
            status: ready
            ---

            # Child
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(
        dir.path(),
        &["--count", "--roots", "--refs-to", "child", "--meta", "status=ready"],
    );

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "1\n");
}

#[test]
fn test_find_count_ignores_limit_and_format() {
    let dir = setup_workspace();

    for i in 1..=5 {
        write(
            dir.path().join(format!("doc{}.md", i)),
            format!("# Document {}\n\nContent.", i),
        )
        .unwrap();
    }

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--count", "--limit", "2", "-f", "json"]);

    assert!(success, "stderr: {}", stderr);
    assert_eq!(stdout, "5\n");
}

