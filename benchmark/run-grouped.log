    assert!(graph.get_metadata(&keys[0]).is_some(), "metadata should be present");
    let meta = graph.get_metadata(&keys[0]).unwrap();
    eprintln!("Parsing metadata as YAML...");
    let val: serde_yaml::Value = serde_yaml::from_str(meta).unwrap();
    eprintln!("val={:?}", val);
    let depends = val.get("depends");
    eprintln!("depends={:?}", depends);
    assert!(depends.is_some(), "depends key should exist in metadata");
}
