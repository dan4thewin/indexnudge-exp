   640	fn add_default_type_to_actions(input: &str) -> String {
   641	    let mut doc = input.parse::<DocumentMut>().expect("valid TOML");
   642	
   643	    if let Some(Item::Table(actions)) = doc.get_mut("actions") {
   644	        for (_, action) in actions.iter_mut() {
   645	            if let Item::Table(action_table) = action {
   646	                action_table.entry("type").or_insert(value("transform"));
   647	            }
   648	        }
   649	    }
   650	
   651	    doc.to_string()
   652	}
   653	
   654	fn add_refs_extension_field(input: &str) -> String {
   655	    let mut doc = input.parse::<DocumentMut>().expect("valid TOML");
   656	
   657	    if doc.get("markdown").is_none() {
   658	        doc["markdown"] = Item::Table(toml_edit::Table::new());
   659	    }
   660	
   661	    if let Some(Item::Table(markdown)) = doc.get_mut("markdown") {
   662	        if markdown.get("refs_extension").is_none() {
   663	            markdown.insert("refs_extension", value(""));
   664	        }
   665	    }
   666	
   667	    doc.to_string()
   668	}
   669	
   670	fn add_link_action(input: &str) -> String {
   671	    let mut doc = input.parse::<DocumentMut>().expect("valid TOML");
   672	
   673	    if doc.get("actions").is_none() {
   674	        doc["actions"] = Item::Table(toml_edit::Table::new());
   675	    }
   676	
   677	    if let Some(Item::Table(actions)) = doc.get_mut("actions") {
   678	        // Check if link action already exists
   679	        let has_link = actions.iter().any(|(_, action)| {
   680	            if let Item::Table(action_table) = action {
   681	                if let Some(Item::Value(action_type)) = action_table.get("type") {
   682	                    if let Some(type_str) = action_type.as_str() {
   683	                        return type_str == "link";
   684	                    }
   685	                }
   686	            }
   687	            false
   688	        });
   689	
   690	        if !has_link {
   691	            let mut link_table = toml_edit::Table::new();
   692	            link_table.insert("type", value("link"));
   693	            link_table.insert("title", value("Link word"));
   694	            link_table.insert("link_type", value("markdown"));
   695	            link_table.insert("key_template", value("{{id}}"));
   696	            actions.insert("link", Item::Table(link_table));
   697	        }
   698	    }
   699	
   700	    doc.to_string()
   701	}
