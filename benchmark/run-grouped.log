37|pub fn new_form_pairs(files: Vec<&str>) -> State {
38|    let pairs = files
39|        .iter()
40|        .enumerate()
41|        .filter(|(i, _)| i % 2 == 0)
42|        .map(|(_, name)| name)
43|        .zip(
44|            files
45|                .iter()
46|                .enumerate()
47|                .filter(|(i, _)| i % 2 == 1)
48|                .map(|(_, content)| content),
49|        );
50|
51|    pairs
52|        .map(|(name, content)| (name.to_string(), content.to_string()))
53|        .collect()
54|}
