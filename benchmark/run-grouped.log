#[test]
fn test_find_meta_matches_bare_frontmatter_sequence() {
    let dir = setup_bare_frontmatter_workspace();

    write(
        dir.path().join("task.md"),
        indoc! {"
            title: Task A
            depends:
              - foo

            # Task A
        "},
    )
    .unwrap();

    let (stdout, stderr, success) = run_iwe(dir.path(), &["--meta", "depends=foo", "-f", "json"]);

    assert!(success, "stderr: {}", stderr);
    let parsed: serde_json::Value = serde_json::from_str(&stdout).expect("valid JSON");
    assert_eq!(parsed["total"], 1);
    assert_eq!(parsed["results"][0]["key"], "task");
}
