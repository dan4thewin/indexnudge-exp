use indoc::indoc;
use liwe::find::{DocumentFinder, FindOptions};
use liwe::graph::Graph;
use liwe::model::config::MarkdownOptions;
use liwe::state::from_indoc;
fn main() {
 let input = indoc! {"
 title: Task A
 depends:
 - foo

 # Task A
 "};
 let graph = Graph::import(&from_indoc(input), MarkdownOptions{bare_frontmatter:true,..Default::default()}, None);
 println!("meta={:?}", graph.get_metadata(&"1".into()));
 let finder = DocumentFinder::new(&graph);
 let output = finder.find(&FindOptions{metadata_filters: vec![("depends".to_string(),"foo".to_string())], ..Default::default()});
 println!("len={} titles={:?}", output.results.len(), output.results.iter().map(|r|&r.title).collect::<Vec<_>>());
}
