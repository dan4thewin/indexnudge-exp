1630:        eprintln!("Error: Source document '{}' not found", source_key_str);
1631:        std::process::exit(1);
1632:    }
1633:
1634:    let reference_text = (&graph)
1635:        .get_key_title(&source_key)
1636:        .unwrap_or_else(|| source_key_str.clone());
1637:
1638:    let library_path = get_library_path(&config);
1639:
1640:    for action_name in &args.to {
1641:        let attach = match config.actions.get(action_name) {
