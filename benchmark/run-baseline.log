1001:fn apply_changes(changes: &Changes, configuration: &Configuration) {
1002:    let library_path = get_library_path(configuration);
1003:
1004:    for key in &changes.removes {
1005:        let file_path = library_path.join(format!("{}.md", key));
1006:        if file_path.exists() {
1007:            std::fs::remove_file(&file_path).expect("Failed to delete document file");
1008:        }
1009:    }
1010:
1011:    for (key, markdown) in &changes.creates {
1012:        let file_path = library_path.join(format!("{}.md", key));
1013:        if let Some(parent) = file_path.parent() {
1014:            std::fs::create_dir_all(parent).ok();
1015:        }
1016:        std::fs::write(&file_path, markdown).expect("Failed to write document file");
1017:    }
1018:
1019:    for (key, markdown) in &changes.updates {
1020:        let file_path = library_path.join(format!("{}.md", key));
1021:        std::fs::write(&file_path, markdown).expect("Failed to write document file");
1022:    }
1023:}
