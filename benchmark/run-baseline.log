1105:fn export_command(args: Export) {
1106:    let config = get_configuration();
1107:    let graph = load_graph(&config);
1108:
1109:    let explicit_keys: Vec<Key> = args.key.iter().map(|s| Key::name(s)).collect();
1110:
1111:    let selector: liwe::selector::Selector = args.selector.into();
1112:    let resolved_keys: Vec<Key> = if !selector.is_empty() {
1113:        let selector_set = selector.resolve(&graph);
1114:        let mut v: Vec<Key> = if explicit_keys.is_empty() {
1115:            selector_set.into_iter().collect()
1116:        } else {
1117:            explicit_keys
1118:                .into_iter()
1119:                .filter(|k| selector_set.contains(k))
1120:                .collect()
