1048:fn get_configuration() -> Configuration {
1049:    let config = load_config();
1050:    if log::log_enabled!(log::Level::Debug) {
1051:        let formatted_config =
1052:            toml::to_string_pretty(&config).unwrap_or_else(|_| format!("{:#?}", config));
1053:        debug!("using config:\n{}", formatted_config);
1054:    }
1055:    config
1056:}
