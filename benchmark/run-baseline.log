1025:fn load_graph(configuration: &Configuration) -> Graph {
1026:    Graph::import(
1027:        &new_for_path_with_options(
1028:            &get_library_path(configuration),
1029:            configuration.library.virtual_directories,
1030:        ),
1031:        configuration.markdown.clone(),
1032:        configuration.library.frontmatter_document_title.clone(),
1033:    )
1034:}
