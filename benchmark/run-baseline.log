423|#[tool_router]
424|impl IweServer {
425|    #[tool(description = "Search and discover documents in the knowledge graph. Supports fuzzy text query (`query`), root filter (`roots`), direct-reference filters (`refs_to`, `refs_from`), and the structural set selector (`in` / `in_any` / `not_in` / `max_depth`) for transitive sub-document AND/OR/NOT queries with configurable depth.")]
426|    async fn iwe_find(
427|        &self,
428|        Parameters(params): Parameters<FindParams>,
429|    ) -> Result<CallToolResult, McpError> {
430|        let graph = self.graph.lock().await;
431|        let finder = DocumentFinder::new(&graph);
432|        let output: FindOutput = finder.find(&params.into());
433|        to_json_result(&output)
434|    }
435|
436|    #[tool(description = "Retrieve documents from the knowledge graph with configurable depth expansion, parent context, backlinks, and linked documents")]
437|    async fn iwe_retrieve(
438|        &self,
439|        Parameters(params): Parameters<RetrieveParams>,
440|    ) -> Result<CallToolResult, McpError> {
441|        let graph = self.graph.lock().await;
442|        let reader = DocumentReader::new(&graph);
443|        let keys: Vec<Key> = params.keys.iter().map(|k| Key::name(k)).collect();
444|        let options: RetrieveOptions = params.into();
445|        let output: RetrieveOutput = reader.retrieve_many(&keys, &options);
