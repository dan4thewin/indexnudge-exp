355|    pub fn from_state(
356|        state: State,
357|        sequential_ids: bool,
358|        markdown_options: MarkdownOptions,
359|        frontmatter_document_title: Option<String>,
360|    ) -> Self {
361|        let mut graph = Graph::new_with_options(markdown_options.clone());
362|        graph.set_sequential_keys(sequential_ids);
363|        graph.frontmatter_document_title = frontmatter_document_title;
364|
365|        let reader = MarkdownReader::new();
366|
367|        let blocks = state
368|            .iter()
369|            .sorted_by(|a, b| a.0.cmp(b.0))
370|            .collect_vec()
371|            .par_iter()
372|            .map(|(k, v)| {
373|                debug!("parsing content, key={}", k);
374|                (Key::name(k), reader.document(v, &markdown_options))
375|            })
376|            .collect::<Vec<_>>();
377|
378|        for (key, document) in blocks.into_iter() {
379|            if let Some(meta) = document.metadata.clone() {
380|                graph.metadata.insert(key.clone(), meta);
381|            } else {
382|                graph.metadata.remove(&key);
383|            }
384|
385|            let nodes_map =
386|                SectionsBuilder::new(&mut graph.build_key(&key), &document.blocks, &key)
387|                    .nodes_map();
388|            graph.nodes_map.insert(key.clone(), nodes_map.clone());
389|            graph.global_nodes_map.extend(nodes_map);
390|        }
391|
392|        let mut index = RefIndex::new();
393|        for node in graph.arena.nodes() {
394|            index.index_node(&graph, node.id());
395|        }
396|        graph.index = index;
397|
398|        for (key, _) in graph.keys.clone() {
399|            graph
400|                .extract_ref_text(&key)
401|                .map(|text| graph.keys_to_ref_text.insert(key.clone(), text));
402|        }
403|
404|        graph.content = state
405|            .iter()
406|            .map(|(k, v)| (Key::name(k), v.clone()))
407|            .collect();
408|
409|        graph
410|    }

