670|        refs_from: args.refs_from.map(|s| Key::name(&s)),
671|        selector: args.selector.into(),
672|        limit: args.limit,
673|        metadata_filters: args.meta,
674|    };
675|
676|    let output = finder.find(&options);
677|
678|    match args.format {
679|        FindFormat::Json => {
680|            let json = serde_json::to_string_pretty(&output).expect("Failed to serialize to JSON");
681|            println!("{}", json);
682|        }
683|        FindFormat::Keys => {
684|            for result in &output.results {
685|                println!("{}", result.key);
686|            }
687|        }
688|        FindFormat::Markdown => {
689|            let rendered = render_find_output(&output);
690|            print!("{}", rendered);
691|        }
692|    }
693|}
694|
695|fn render_find_output(output: &iwe::find::FindOutput) -> String {
696|    let mut result = String::new();
697|
698|    result.push_str(&format!("Found {} results", output.total));
699|    if let Some(ref query) = output.query {
700|        result.push_str(&format!(" for \"{}\"", query));
701|    }
702|    if let Some(limit) = output.limit {
703|        result.push_str(&format!(" (showing {})", limit));
704|    }
705|    result.push_str(":\n\n");
706|
707|    for r in &output.results {
708|        result.push_str(&format!("{}   #{}\n", r.display_title, r.key));
709|    }
710|
711|    result
712|}
