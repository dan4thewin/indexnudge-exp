#[test]
fn writer_emits_fenced_when_disabled() {
    setup();

    let graph = Graph::import(
        &from_indoc(indoc! {"
            ---
            title: Foo
            ---

            # Body
            "}),
        MarkdownOptions::default(),
        None,
    );

    let state = graph.export();
    let content = state.values().next().unwrap();
    assert!(content.starts_with("---\ntitle: Foo\n---"));
}

#[test]
fn frontmatter_title_works_with_bare() {
    setup();

