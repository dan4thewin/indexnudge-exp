+
+        // Query 3: table list for the nudge
+        let tables_query = "SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE '%fts%' ORDER BY name;";
+        let tables_output = run_sqlite3(&db, tables_query);
+
