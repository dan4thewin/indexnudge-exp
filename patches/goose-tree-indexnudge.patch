+/// Check once per process whether indexnudge binary and shims are on PATH.
+/// Two checks: (1) is `indexnudge` on PATH at all, (2) is the first `sed`
+/// on PATH the shim (contains "indexnudge" in the first 512 bytes).
+fn shims_on_path() -> &'static Option<String> {
+    static RESULT: OnceLock<Option<String>> = OnceLock::new();
+    RESULT.get_or_init(|| {
+        let path_var = std::env::var("PATH").unwrap_or_default();
+        let dirs: Vec<&str> = path_var.split(':').collect();
+
+        // Check 1: is indexnudge binary on PATH?
+        let has_indexnudge = dirs.iter().any(|dir| {
+            PathBuf::from(dir).join("indexnudge").is_file()
+        });
+        if !has_indexnudge {
+            return Some(
+                "Note: .indexnudge.db found but indexnudge not on PATH. \
+                 The shims need the indexnudge binary for incremental reindexing.".to_string()
+            );
+        }
+
+        // Check 2: is the first sed on PATH the shim?
+        for dir in &dirs {
+            let candidate = PathBuf::from(dir).join("sed");
+            if candidate.is_file() {
+                if let Ok(bytes) = fs::read(&candidate) {
+                    let check = &bytes[..bytes.len().min(512)];
+                    if check.windows(10).any(|w| w == b"indexnudge") {
+                        return None; // shim found first — all good
+                    }
+                }
+                return Some(
+                    "Note: .indexnudge.db found but indexnudge shims not first on PATH. \
+                     Add: export PATH=/path/to/indexnudge/bin:$PATH".to_string()
+                );
+            }
+        }
+        Some(
+            "Note: .indexnudge.db found but sed not found on PATH. \
+             Add: export PATH=/path/to/indexnudge/bin:$PATH".to_string()
+        )
+    })
+}
+
+/// Check once per process whether sqlite3 is on PATH.
+fn has_sqlite3() -> bool {
+    static RESULT: OnceLock<bool> = OnceLock::new();
+    *RESULT.get_or_init(|| {
+        let path_var = std::env::var("PATH").unwrap_or_default();
+        path_var.split(':').any(|dir| PathBuf::from(dir).join("sqlite3").is_file())
+    })
+}
+
+/// Walk up from `start` looking for .indexnudge.db
+fn find_index_db(start: &Path) -> Option<PathBuf> {
+    let mut dir = start.to_path_buf();
+    loop {
+        let candidate = dir.join(".indexnudge.db");
+        if candidate.is_file() {
+            return Some(candidate);
+        }
+        if !dir.pop() {
+            return None;
+        }
+    }
+}
+
+/// Shell out to sqlite3 and return stdout
+fn run_sqlite3(db: &str, query: &str) -> String {
+    Command::new("sqlite3")
+        .arg(db)
+        .arg(query)
+        .output()
+        .map(|o| String::from_utf8_lossy(&o.stdout).to_string())
+        .unwrap_or_default()
+}
